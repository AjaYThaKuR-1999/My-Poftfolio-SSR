<!-- Welcome Overlay Initializer Function -->
<script>
    const defaultLogs = `
        <div class="flex items-center gap-1.5">
            <span class="text-cyan-400 font-bold">&gt;</span> 
            <span class="text-slate-200">INITIATING DIRECT CONNECT...</span>
        </div>
        <div class="flex items-center justify-between pl-3">
            <span>RECIPIENT: AJAY_THAKUR</span> 
            <span class="text-emerald-450 font-extrabold tracking-wide text-[8.5px] bg-emerald-500/10 px-1.5 py-0.5 rounded border border-emerald-500/20">[ONLINE]</span>
        </div>
        <div class="flex items-center justify-between pl-3">
            <span>CONNECTION_STATUS: READY</span>
            <span class="text-cyan-455 font-bold">[WSS_SECURE]</span>
        </div>
        <div class="flex items-center gap-1 mt-0.5">
            <span class="text-cyan-400 font-bold">&gt;</span> 
            <span class="text-indigo-305">Ready to accept your message!</span>
            <span class="inline-block w-1.5 h-3 bg-cyan-400 animate-pulse align-middle"></span>
        </div>`;

    const logTemplates = {
        realtime: `
            <div class="flex items-center gap-1.5">
                <span class="text-cyan-400 font-bold">&gt;</span> 
                <span class="text-slate-200">QUERYING TELEMETRY // UPLINK</span>
            </div>
            <div class="flex items-center justify-between pl-3">
                <span>PROTOCOL: WebSocket (WSS)</span> 
                <span class="text-cyan-450 font-bold">100% OK</span>
            </div>
            <div class="flex items-center justify-between pl-3">
                <span>AVG_LATENCY: 24ms (RTT)</span> 
                <span class="text-emerald-400 font-bold">[EXCELLENT]</span>
            </div>
            <div class="flex items-center gap-1 mt-0.5">
                <span class="text-cyan-400 font-bold">&gt;</span> 
                <span class="text-slate-500">Live stream diagnostic active...</span>
                <span class="inline-block w-1.5 h-3 bg-cyan-400 animate-pulse align-middle"></span>
            </div>`,
        secure: `
            <div class="flex items-center gap-1.5">
                <span class="text-cyan-400 font-bold">&gt;</span> 
                <span class="text-slate-200">VERIFYING TRANSPORT ENCRYPTION</span>
            </div>
            <div class="flex items-center justify-between pl-3">
                <span>ALGORITHM: AES-256-GCM</span> 
                <span class="text-indigo-400 font-bold">CIPHER_OK</span>
            </div>
            <div class="flex items-center justify-between pl-3">
                <span>SIGNATURE: RSA_SHA256_RSA</span> 
                <span class="text-cyan-450 font-bold">[VERIFIED]</span>
            </div>
            <div class="flex items-center gap-1 mt-0.5">
                <span class="text-cyan-400 font-bold">&gt;</span> 
                <span class="text-slate-550 font-medium">Frames protected. Integrity checked.</span>
                <span class="inline-block w-1.5 h-3 bg-cyan-400 animate-pulse align-middle"></span>
            </div>`,
        delivery: `
            <div class="flex items-center gap-1.5">
                <span class="text-cyan-400 font-bold">&gt;</span> 
                <span class="text-slate-200">DIAGNOSING INBOX PIPELINE</span>
            </div>
            <div class="flex items-center justify-between pl-3">
                <span>DELIVERY_GATE: DIRECT_INBOX</span> 
                <span class="text-emerald-400 font-bold">[BYPASS_SPAM]</span>
            </div>
            <div class="flex items-center justify-between pl-3">
                <span>NOTIFICATION: MOBILE_PUSH</span> 
                <span class="text-cyan-400 font-bold">ACTIVE</span>
            </div>
            <div class="flex items-center gap-1 mt-0.5">
                <span class="text-cyan-400 font-bold">&gt;</span> 
                <span class="text-slate-550">Alert triggers set on incoming wss...</span>
                <span class="inline-block w-1.5 h-3 bg-cyan-400 animate-pulse align-middle"></span>
            </div>`,
        intents: `
            <div class="flex items-center gap-1.5">
                <span class="text-cyan-400 font-bold">&gt;</span> 
                <span class="text-slate-200">CATEGORIZING ROUTE INTENTS</span>
            </div>
            <div class="flex items-center justify-between pl-3">
                <span>INTENT_PARSER: LOCAL_API</span> 
                <span class="text-emerald-400 font-bold">[READY]</span>
            </div>
            <div class="flex items-center justify-between pl-3">
                <span>COMPATIBLE_MODES: 5 ROUTES</span> 
                <span class="text-indigo-400 font-bold">CONTEXT_AWARE</span>
            </div>
            <div class="flex items-center gap-1 mt-0.5">
                <span class="text-cyan-400 font-bold">&gt;</span> 
                <span class="text-slate-500">Awaiting user categorization...</span>
                <span class="inline-block w-1.5 h-3 bg-cyan-400 animate-pulse align-middle"></span>
            </div>`,
        btn_hover: `
            <div class="flex items-center gap-1.5">
                <span class="text-cyan-400 font-bold">&gt;</span> 
                <span class="text-slate-205">ESTABLISHING HANDSHAKE ROUTE...</span>
            </div>
            <div class="flex items-center justify-between pl-3">
                <span>TARGET_NODE: /dashboard</span> 
                <span class="text-primary-400 font-bold">[HANDSHAKE]</span>
            </div>
            <div class="flex items-center justify-between pl-3">
                <span>SESSION_UPLINK: WAITING</span> 
                <span class="text-cyan-400 font-bold animate-pulse">[READY_TO_LAUNCH]</span>
            </div>
            <div class="flex items-center gap-1 mt-0.5">
                <span class="text-cyan-400 font-bold">&gt;</span> 
                <span class="text-primary-400 font-bold animate-pulse">Click to initialize secure console...</span>
                <span class="inline-block w-1.5 h-3 bg-primary-400 animate-pulse align-middle"></span>
            </div>`
    };

    function showTerminalLog(key) {
        const logBody = document.getElementById('terminal-log-body');
        if (logBody && logTemplates[key]) {
            logBody.innerHTML = logTemplates[key];
        }

        const terminal = document.getElementById('diagnostics-terminal');
        if (terminal) {
            if (key === 'realtime') {
                terminal.style.borderColor = 'rgba(6, 182, 212, 0.45)';
                terminal.style.boxShadow = '0 10px 30px rgba(0,0,0,0.55), 0 0 25px rgba(6, 182, 212, 0.15)';
            } else if (key === 'secure') {
                terminal.style.borderColor = 'rgba(99, 102, 241, 0.45)';
                terminal.style.boxShadow = '0 10px 30px rgba(0,0,0,0.55), 0 0 25px rgba(99, 102, 241, 0.15)';
            } else if (key === 'delivery') {
                terminal.style.borderColor = 'rgba(236, 72, 153, 0.45)';
                terminal.style.boxShadow = '0 10px 30px rgba(0,0,0,0.55), 0 0 25px rgba(236, 72, 153, 0.15)';
            } else if (key === 'intents') {
                terminal.style.borderColor = 'rgba(245, 158, 11, 0.45)';
                terminal.style.boxShadow = '0 10px 30px rgba(0,0,0,0.55), 0 0 25px rgba(245, 158, 11, 0.15)';
            } else if (key === 'btn_hover') {
                terminal.style.borderColor = 'rgba(99, 102, 241, 0.55)';
                terminal.style.boxShadow = '0 10px 30px rgba(0,0,0,0.55), 0 0 30px rgba(99, 102, 241, 0.25)';
            }
        }
    }

    function resetTerminalLog() {
        const logBody = document.getElementById('terminal-log-body');
        if (logBody) {
            logBody.innerHTML = defaultLogs;
        }

        const terminal = document.getElementById('diagnostics-terminal');
        if (terminal) {
            terminal.style.borderColor = '';
            terminal.style.boxShadow = '';
        }
    }

    function handleActionClick() {
        if (window.location.pathname === '/dashboard') {
            initializeConsole();
        } else {
            // Redirect to dashboard and scroll to the Get In Touch section
            window.location.href = '/dashboard#get-in-touch';
        }
    }

    function initializeConsole() {
        const welcomeOverlay = document.getElementById('chat-overlay-welcome');
        if (welcomeOverlay) {
            welcomeOverlay.classList.add('opacity-0', 'pointer-events-none');
        }
        const activeContent = document.getElementById('chat-active-content');
        if (activeContent) {
            activeContent.classList.remove('opacity-0', 'pointer-events-none');
        }

        // Highlight the intent grid briefly to guide the user
        const grid = document.getElementById('intent-grid-container');
        if (grid) {
            grid.classList.add('ring-2', 'ring-primary-500/50');
            setTimeout(() => {
                grid.classList.remove('ring-2', 'ring-primary-500/50');
            }, 1500);
        }
    }

    // Auto-scroll to #get-in-touch section when redirected from Home page
    document.addEventListener('DOMContentLoaded', () => {
        if (window.location.pathname === '/dashboard' && window.location.hash === '#get-in-touch') {
            const section = document.getElementById('get-in-touch');
            if (section) {
                setTimeout(() => {
                    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 200);
            }
        }
    });
</script>

<% if (typeof user !=='undefined' && user) { %>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.location.pathname !== '/dashboard') {
                console.log('[Socket] Not on dashboard. Skipping socket connection.');
                return;
            }
            const socket = io();
            const chatFeed = document.querySelector('.custom-scrollbar');
            const chatForm = document.getElementById('chat-console-form');
            const messageInput = document.getElementById('console-message');
            const subjectInput = document.getElementById('console-subject');
            const placeholder = document.querySelector('.no-messages-placeholder');

            // Auto scroll to bottom
            if (chatFeed) {
                chatFeed.scrollTop = chatFeed.scrollHeight;
            }

            // Join user room
            socket.emit('joinRoom', { targetUserId: '<%= user._id %>' });

            // Disconnect gracefully on navigating away
            window.addEventListener('beforeunload', () => {
                console.log('[Socket] Disconnecting socket due to page unload');
                socket.disconnect();
            });

            // Listen for active presence status
            socket.on('presenceStatus', (data) => {
                const subStatus = document.getElementById('presence-subtitle-status');
                const badge = document.getElementById('presence-badge');
                console.log('[Presence] Received active presence status:', data.active);
                if (data.active) {
                    if (subStatus) subStatus.classList.remove('hidden');
                    if (badge) badge.classList.remove('hidden');
                } else {
                    if (subStatus) subStatus.classList.add('hidden');
                    if (badge) badge.classList.add('hidden');
                }
            });

            // Listen for messages read notification
            socket.on('messagesRead', () => {
                console.log('[Socket] Received messagesRead notification, turning ticks blue.');
                document.querySelectorAll('.fa-check-double').forEach(icon => {
                    icon.classList.remove('text-slate-500', 'text-primary-400');
                    icon.classList.add('text-sky-400');
                });
            });

            // Handle sending messages
            if (chatForm) {
                chatForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    if (!messageInput) return;

                    const val = messageInput.value.trim();
                    if (!val) return;

                    socket.emit('sendMessage', {
                        message: val,
                        messageIntent: subjectInput ? subjectInput.value : ''
                    });

                    messageInput.value = '';
                });

                if (messageInput) {
                    messageInput.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter' && !e.shiftKey && !messageInput.disabled) {
                            e.preventDefault();
                            chatForm.dispatchEvent(new Event('submit'));
                        }
                    });
                }
            }

            // Receive real-time messages
            socket.on('receiveMessage', (msg) => {
                if (!chatFeed) return;

                if (placeholder) {
                    placeholder.remove();
                }

                const isMe = msg.sender === '<%= user._id %>';
                let html = '';
                const timeStr = new Date(msg.createdAt).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });

                if (isMe) {
                    let intentBadge = '';
                    if (msg.messageIntent) {
                        const displayIntent = msg.messageIntent === 'General Inquiry' ? 'General' : msg.messageIntent;
                        intentBadge = `
                        <div class="flex justify-end mb-1 pr-8 select-none">
                            <span class="inline-block px-1.5 py-px bg-primary-950/80 border border-primary-900/60 text-primary-400 rounded text-[9px] font-extrabold uppercase tracking-wide">
                                ${escapeHTML(displayIntent)}
                            </span>
                        </div>
                    `;
                    }
                    const userPic = `<%= user.profilePicture %>`;
                    const userAvatarHtml = userPic
                        ? `<img src="${userPic}" alt="<%= user.name %>" class="w-6 h-6 rounded-full object-cover">`
                        : `<div class="w-6 h-6 rounded bg-primary-600/20 border border-primary-550/20 flex items-center justify-center text-primary-400 text-[10px] font-black shrink-0 select-none"><%= user.name.charAt(0).toUpperCase() %></div>`;

                    html = `
                    <div class="animate-fade-in">
                        ${intentBadge}
                        <div class="flex items-end justify-end gap-2">
                            <div class="chat-bubble-user w-fit max-w-[75%] px-3 py-2 rounded-2xl rounded-tr-none shadow-md">
                                <p class="text-[13.5px] md:text-[14px] text-slate-200 leading-snug font-medium whitespace-pre-wrap break-words">${escapeHTML(msg.message)}</p>
                                <div class="flex items-center justify-end gap-1 mt-0.5">
                                    <span class="text-[9.5px] text-slate-500 leading-none">${timeStr}</span>
                                    <i class="fas fa-check-double text-[8px] ${msg.isRead ? 'text-sky-400' : 'text-slate-500'}"></i>
                                </div>
                            </div>
                            <div class="relative shrink-0 select-none">
                                ${userAvatarHtml}
                            </div>
                        </div>
                    </div>
                `;
                } else {
                    const adminPic = `<%= typeof adminProfilePicture !== 'undefined' && adminProfilePicture ? adminProfilePicture : '' %>`;
                    const avatarHtml = adminPic
                        ? `<img src="${adminPic}" alt="Admin" class="w-6 h-6 rounded-full object-cover">`
                        : `<div class="w-6 h-6 rounded bg-primary-650/20 border border-primary-500/20 flex items-center justify-center text-primary-400 text-[10px] font-black shrink-0 select-none">A</div>`;

                    html = `
                    <div class="flex items-end gap-2 animate-fade-in">
                        <div class="relative shrink-0 select-none">
                            ${avatarHtml}
                        </div>
                        <div class="chat-bubble-admin w-fit max-w-[75%] px-3 py-2 rounded-2xl rounded-tl-none shadow-md">
                            <p class="text-[13.5px] md:text-[14px] text-slate-300 leading-snug font-medium whitespace-pre-wrap break-words">${escapeHTML(msg.message)}</p>
                            <span class="text-[9.5px] text-slate-500 leading-none block mt-0.5">${timeStr}</span>
                        </div>
                    </div>
                `;
                }

                chatFeed.insertAdjacentHTML('beforeend', html);
                chatFeed.scrollTop = chatFeed.scrollHeight;
            });

            function escapeHTML(str) {
                return str.replace(/[&<>'"]/g,
                    tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
                );
            }
        });
    </script>
    <% } %>