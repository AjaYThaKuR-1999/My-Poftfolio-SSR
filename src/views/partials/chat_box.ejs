                            <div class="flex items-center gap-2">
                                <span
                                    class="w-2.5 h-2.5 rounded-full bg-red-500/50 border border-red-500/20 shadow-[0_0_8px_rgba(239,68,68,0.3)] animate-pulse"></span>
