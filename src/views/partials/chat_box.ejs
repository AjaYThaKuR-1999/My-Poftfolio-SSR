            <% } %>

                <!-- ACTIVE CONSOLE CONTENT -->
                <div id="chat-active-content"
                    class="flex flex-col justify-between flex-1 min-h-0 bg-slate-950/40 transition-opacity duration-500 <%= (typeof messages !== 'undefined' && messages.length === 0) || (typeof isHomePage !== 'undefined' && isHomePage) ? 'opacity-0 pointer-events-none' : '' %>">
                    <!-- Chat Window Header -->
                    <div
                        class="p-4 bg-slate-950/20 border-b border-slate-800/40 flex items-center justify-between shrink-0 select-none relative z-10">
                        <div class="flex items-center gap-3">
                            <div class="relative shrink-0 select-none">
                                <% if (typeof adminProfilePicture !=='undefined' && adminProfilePicture) { %>
                                    <img src="<%= adminProfilePicture %>" alt="Ajay Thakur"
                                        class="w-10 h-10 rounded-xl object-cover bg-slate-950 border border-slate-800/40">
                                    <% } else { %>
                                        <div
                                            class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary-600 to-indigo-650 flex items-center justify-center text-white text-[15.5px] md:text-[17px] font-black shadow-inner">
                                            A
                                        </div>
                                        <% } %>
                            </div>
                            <div>
                                <span class="text-[15.5px] md:text-[17px] font-black text-white block">Ajay
                                    Thakur</span>
                                <span
                                    class="text-[12px] md:text-[13px] text-slate-400 font-medium flex items-center gap-1.5 leading-none mt-0.5">
                                    Backend Systems Architect <span id="presence-subtitle-status" class="hidden">&bull;
                                        <span class="text-emerald-400 font-bold">Active</span></span>
                                </span>
                            </div>
                        </div>

                        <!-- Glowing Live Connection tag/tile -->
                        <span id="presence-badge"
                            class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[11px] md:text-[12px] font-extrabold uppercase tracking-widest text-emerald-400 select-none shadow-[0_0_12px_rgba(16,185,129,0.1)]">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            Live Connection
                        </span>
                    </div>

                    <!-- Chat Message Feed -->
                    <div class="flex-1 overflow-y-auto space-y-4 p-5 bg-transparent custom-scrollbar relative min-h-0">
                        <% if (typeof messages !=='undefined' && messages && messages.length> 0) { %>
                            <% messages.forEach(msg=> { %>
                                <% if (typeof user !=='undefined' && user &&
                                    msg.sender.toString()===user._id.toString()) { %>
                                    <!-- User Message (Right side) -->
                                    <div class="animate-fade-in">
                                        <% if (msg.messageIntent) { %>
                                            <div class="flex justify-end mb-1 pr-8 select-none">
                                                <span
                                                    class="inline-block px-1.5 py-px bg-primary-950/80 border border-primary-900/60 text-primary-400 rounded text-[9px] font-extrabold uppercase tracking-wide">
                                                    <%= msg.messageIntent==='General Inquiry' ? 'General' : msg.messageIntent %>
                                                </span>
                                            </div>
                                        <% } %>
                                        <div class="flex items-end justify-end gap-2">
                                            <div class="chat-bubble-user w-fit max-w-[75%] px-3 py-2 rounded-2xl rounded-tr-none shadow-md">
                                                <p class="text-[13.5px] md:text-[14px] text-slate-200 leading-snug font-medium break-words"><%= msg.message %></p>
                                                <div class="flex items-center justify-end gap-1 mt-0.5">
                                                    <span class="text-[9.5px] text-slate-500 leading-none"><%= new Date(msg.createdAt).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) %></span>
                                                    <i class="fas fa-check-double text-[8px] <%= msg.isRead ? 'text-sky-400' : 'text-slate-500' %>"></i>
                                                </div>
                                            </div>
                                            <div class="relative shrink-0 select-none">
                                                <% if (user.profilePicture) { %>
                                                    <img src="<%= user.profilePicture %>" alt="<%= user.name %>" class="w-6 h-6 rounded-full object-cover">
                                                <% } else { %>
                                                    <div class="w-6 h-6 rounded bg-primary-650/25 border border-primary-550/25 flex items-center justify-center text-primary-450 text-[10px] font-black shrink-0 select-none">
                                                        <%= user.name.charAt(0).toUpperCase() %>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <% } else { %>
