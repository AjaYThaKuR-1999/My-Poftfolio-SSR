                            <div
                                class="absolute top-0 right-0 w-1.5 h-1.5 border-t border-r border-pink-500/30 opacity-0 group-hover/tile:opacity-100 transition-opacity">
                            </div>
                            <div class="flex items-center gap-3 relative z-10">
                                <div
                                    class="w-8 h-8 rounded-lg bg-pink-500/10 border border-pink-500/25 flex items-center justify-center text-pink-400 shrink-0 text-xs shadow-[0_0_15px_rgba(236,72,153,0.1)] group-hover/tile:scale-105 transition-transform">
                                    <i class="fas fa-paper-plane animate-bounce-slow"></i>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <span
