                                <span class="text-slate-200">INITIATING DIRECT CONNECT...</span>
                            </div>
                            <div class="flex items-center justify-between pl-3.5">
                                <span>RECIPIENT: AJAY_THAKUR</span>
                                <span
                                    class="text-emerald-450 font-extrabold tracking-wide text-[9.5px] bg-emerald-500/10 px-1.5 py-0.5 rounded border border-emerald-500/20">[ONLINE]</span>
                            </div>
                            <div class="flex items-center justify-between pl-3.5">
                                <span>CONNECTION_STATUS: READY</span>
                                <span class="text-cyan-455 font-bold">[WSS_SECURE]</span>
                            </div>
                            <div class="flex items-center gap-1.5 mt-1">
                                <span class="text-cyan-400 font-bold">&gt;</span>
                                <span class="text-indigo-300">Ready to accept your message!</span>
                                <span class="inline-block w-1.5 h-3 bg-cyan-400 animate-pulse align-middle"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <button type="button" onclick="handleActionClick()" onmouseenter="showTerminalLog('btn_hover')"
                        onmouseleave="resetTerminalLog()"
                        class="btn-primary w-full max-w-[520px] py-3 text-xs font-black uppercase tracking-widest shadow-lg shadow-primary-500/25 flex items-center justify-center gap-2 cursor-pointer transition-all hover:scale-[1.01] active:scale-[0.99] relative overflow-hidden group/btn">
                        <span
                            class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover/btn:animate-shimmer"></span>
                        <span>Start Chat Session</span>
