<header class="fixed top-0 left-0 w-full z-50 transition-all duration-500 bg-slate-950/20 backdrop-blur-md border-b border-white/5" id="main-header">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-24 transition-all duration-500" id="header-container">
            <!-- Logo -->
            <div class="flex-shrink-0 flex items-center">
                <a href="/" class="flex items-center gap-3 group">
                    <div class="w-12 h-12 bg-primary-600 rounded-xl flex items-center justify-center group-hover:rotate-6 transition-transform shadow-lg shadow-primary-600/20">
                        <span class="text-2xl font-black text-white">A</span>
                    </div>
                    <span class="text-2xl font-black tracking-tight text-white group-hover:text-primary-400 transition-colors uppercase italic">Ajay <span class="text-primary-500">Kumar</span></span>
                </a>
            </div>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex space-x-8 items-center">
                <a href="/" class="text-sm font-medium hover:text-primary-400 transition-colors">Home</a>
                <a href="/#skills" class="text-sm font-medium hover:text-primary-400 transition-colors">Skills</a>
                <a href="/#experience" class="text-sm font-medium hover:text-primary-400 transition-colors">Experience</a>
                <a href="/#projects" class="text-sm font-medium hover:text-primary-400 transition-colors">Projects</a>
                <a href="/#contact" class="text-sm font-medium hover:text-primary-400 transition-colors">Let's Connect</a>
                
                <% if (user) { %>
                    <a href="/dashboard" class="text-sm font-medium hover:text-primary-400 transition-colors">Dashboard</a>
                    <% if (user.role === 'admin') { %>
                        <a href="/users" class="text-sm font-medium hover:text-primary-400 transition-colors">Users</a>
                    <% } %>
                    <a href="/auth/logout" class="text-sm font-medium px-4 py-2 border border-slate-700 rounded-lg hover:border-primary-500 hover:text-primary-400 transition-all">Logout</a>
                <% } else { %>
                    <a href="/auth/login" class="text-sm font-medium hover:text-primary-400 transition-colors">Login</a>
                    <a href="/auth/register" class="btn-primary text-sm">Join Now</a>
                <% } %>
            </nav>

            <!-- Mobile menu button -->
            <div class="md:hidden flex items-center">
                <button type="button" class="text-slate-400 hover:text-white" id="mobile-menu-button">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div class="hidden md:hidden bg-slate-900 border-b border-slate-800 animate-slide-down" id="mobile-menu">
        <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 text-center">
            <a href="/" class="block px-3 py-4 text-base font-medium border-b border-slate-800">Home</a>
            <a href="/#skills" class="block px-3 py-4 text-base font-medium border-b border-slate-800">Skills</a>
            <a href="/#experience" class="block px-3 py-4 text-base font-medium border-b border-slate-800">Experience</a>
            <a href="/#projects" class="block px-3 py-4 text-base font-medium border-b border-slate-800">Projects</a>
            <a href="/#contact" class="block px-3 py-4 text-base font-medium border-b border-slate-800">Let's Connect</a>
            <% if (user) { %>
                <a href="/dashboard" class="block px-3 py-4 text-base font-medium border-b border-slate-800">Dashboard</a>
                <% if (user.role === 'admin') { %>
                    <a href="/users" class="block px-3 py-4 text-base font-medium border-b border-slate-800">Users</a>
                <% } %>
                <a href="/auth/logout" class="block px-3 py-4 text-base font-medium text-red-400">Logout</a>
            <% } else { %>
                <a href="/auth/login" class="block px-3 py-4 text-base font-medium border-b border-slate-800">Login</a>
                <a href="/auth/register" class="block px-3 py-4 text-base font-medium text-primary-400">Join Now</a>
            <% } %>
        </div>
    </div>
</header>
