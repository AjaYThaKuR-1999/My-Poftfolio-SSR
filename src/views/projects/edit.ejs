<section class="pt-32 pb-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="glass-card border-slate-700/50">
            <div class="flex items-center justify-between mb-8 pb-6 border-b border-slate-800">
                <div>
                    <h1 class="text-3xl font-bold text-white mb-2">Edit Project</h1>
                    <p class="text-slate-400 text-sm">Update the details of your project entry.</p>
                </div>
                <a href="/projects/<%= project._id %>" class="px-4 py-2 bg-slate-800 border border-slate-700 hover:border-primary-500 rounded-lg text-sm font-medium transition-all">
                    Cancel & Back
                </a>
            </div>

            <%- include('../partials/flash') %>

            <form action="/projects/<%= project._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="space-y-6">
                <!-- Title -->
                <div>
                    <label class="block text-sm font-medium text-slate-400 mb-2">Project Title</label>
                    <input type="text" name="title" value="<%= project.title %>" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors" placeholder="e.g. Scalable API Gateway">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Category -->
                    <div>
                        <label class="block text-sm font-medium text-slate-400 mb-2">Category</label>
                        <select name="category" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors">
                            <option value="Web Development" <%= project.category === 'Web Development' ? 'selected' : '' %>>Web Development</option>
                            <option value="Mobile App" <%= project.category === 'Mobile App' ? 'selected' : '' %>>Mobile App</option>
                            <option value="Web & Mobile App" <%= project.category === 'Web & Mobile App' ? 'selected' : '' %>>Web & Mobile App</option>
                            <option value="Backend Service & Algorithms" <%= project.category === 'Backend Service & Algorithms' ? 'selected' : '' %>>Backend Service & Algorithms</option>
                        </select>
                    </div>

                    <!-- Project Type -->
                    <div>
                        <label class="block text-sm font-medium text-slate-400 mb-2">Project Type</label>
                        <select name="projectType" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors">
                            <option value="personal" <%= project.projectType === 'personal' ? 'selected' : '' %>>Personal / Learning</option>
                            <option value="professional" <%= project.projectType === 'professional' ? 'selected' : '' %>>Professional / Company</option>
                        </select>
                    </div>
                </div>

                <!-- Images File Selector -->
                <div>
                    <label class="block text-sm font-medium text-slate-400 mb-2">Project Images (Upload new to overwrite, optional)</label>
                    <input type="file" name="images" multiple accept="image/*" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors">
                    <% if (project.rawImageFilename && project.rawImageFilename !== 'no-photo.jpg') { %>
                        <span class="text-[10px] text-slate-500 mt-1 block">Current image: <%= project.rawImageFilename %></span>
                    <% } %>
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-sm font-medium text-slate-400 mb-2">Description</label>
                    <textarea name="description" required rows="5" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors" placeholder="Provide a detailed case study or description of the project..."><%= project.description %></textarea>
                </div>

                <!-- Technologies -->
                <div>
                    <label class="block text-sm font-medium text-slate-400 mb-2">Technologies (Comma-separated)</label>
                    <input type="text" name="technologies" value="<%= project.technologiesRaw %>" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors" placeholder="e.g. Node.js, Express, MongoDB, Docker">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Github URL -->
                    <div>
                        <label class="block text-sm font-medium text-slate-400 mb-2">GitHub Repository URL (Optional)</label>
                        <input type="url" name="githubUrl" value="<%= project.githubUrl %>" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors" placeholder="https://github.com/...">
                    </div>

                    <!-- Live URL -->
                    <div>
                        <label class="block text-sm font-medium text-slate-400 mb-2">Live Demo URL (Optional)</label>
                        <input type="url" name="liveUrl" value="<%= project.liveUrl %>" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors" placeholder="https://...">
                    </div>
                </div>

                <!-- Featured Checkbox -->
                <div class="flex items-center gap-3 py-2">
                    <input type="checkbox" name="featured" id="featured" <%= project.featured ? 'checked' : '' %> class="w-5 h-5 rounded bg-slate-950 border-slate-800 text-primary-600 focus:ring-primary-500 focus:ring-offset-slate-950">
                    <label for="featured" class="text-sm font-medium text-slate-400 select-none cursor-pointer">Feature this project in the landing page showcase</label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="w-full btn-primary py-4 text-lg font-bold">Update Project</button>
            </form>
        </div>
    </div>
</section>
