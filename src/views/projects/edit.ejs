<section class="pt-20 pb-10 min-h-[90vh] flex items-center justify-center relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-primary-600/4 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="glass-card border-slate-700/50 relative p-6 md:p-8 shadow-2xl">
            <!-- Header row: Title + Close button aligned -->
            <div class="mb-6 pb-4 border-b border-slate-800/80 flex items-start justify-between gap-4">
                <div>
                    <h1 class="text-2xl md:text-3xl font-extrabold text-white mb-1 tracking-tight">Edit Project</h1>
                    <p class="text-slate-500 text-xs">Update the details of your project entry.</p>
                </div>
                <a href="/projects/<%= project._id %>" class="shrink-0 text-slate-400 hover:text-white hover:bg-slate-800/60 p-2.5 rounded-xl transition-all text-base" title="Back to Project">
                    <i class="fas fa-times"></i>
                </a>
            </div>

            <%- include('../partials/flash') %>

            <form action="/projects/<%= project._id %>?_method=PUT" method="POST" enctype="multipart/form-data">

                <!-- TWO-COLUMN GRID -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-6">

                    <!-- ====== LEFT: Core Fields ====== -->
                    <div class="space-y-4">

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Project Title</label>
                            <input type="text" name="title" value="<%= project.title %>" required
                                class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all"
                                placeholder="e.g. Scalable API Gateway">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Category</label>
                            <select name="category" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all cursor-pointer">
                                <option value="" disabled <%= !project.category ? 'selected' : '' %>>Select Category</option>
                                <option value="Web Development" <%= project.category === 'Web Development' ? 'selected' : '' %>>Web Development</option>
                                <option value="Mobile App" <%= project.category === 'Mobile App' ? 'selected' : '' %>>Mobile App</option>
                                <option value="Web & Mobile App" <%= project.category === 'Web & Mobile App' ? 'selected' : '' %>>Web & Mobile App</option>
                                <option value="Backend Service & Algorithms" <%= project.category === 'Backend Service & Algorithms' ? 'selected' : '' %>>Backend Service & Algorithms</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Project Type</label>
                            <select name="projectType" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all cursor-pointer">
                                <option value="" disabled <%= !project.projectType ? 'selected' : '' %>>Select Type</option>
                                <option value="personal" <%= project.projectType === 'personal' ? 'selected' : '' %>>Personal / Learning</option>
                                <option value="professional" <%= project.projectType === 'professional' ? 'selected' : '' %>>Professional / Company</option>
                            </select>
                        </div>

                        <!-- Project Logo -->
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Project Logo</label>
                                <label for="logo-input" class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-primary-600/10 border border-primary-500/30 hover:bg-primary-600 hover:border-primary-500 text-primary-400 hover:text-white text-[10px] font-bold uppercase tracking-wide transition-all cursor-pointer">
                                    <i class="fas fa-upload text-[9px]"></i> <%= project.logoUrl ? 'Change' : 'Choose' %>
                                </label>
                                <input type="file" name="logo" id="logo-input" accept="image/*" class="hidden">
                            </div>
                            <div class="flex items-center gap-3 bg-slate-950/40 border border-slate-800 rounded-xl px-3 py-2.5">
                                <% if (project.logoUrl) { %>
                                    <div id="logo-img-wrap" class="w-10 h-10 rounded-lg overflow-hidden border border-slate-700 shrink-0">
                                        <img id="logo-preview-img" src="<%= project.logoUrl %>" alt="Project Logo" class="w-full h-full object-cover">
                                    </div>
                                    <div id="logo-placeholder" class="hidden w-10 h-10 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-600 shrink-0">
                                        <i class="fas fa-image text-sm"></i>
                                    </div>
                                    <span id="logo-preview-name" class="text-[10px] text-slate-300 truncate">Current logo</span>
                                <% } else { %>
                                    <div id="logo-placeholder" class="w-10 h-10 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-600 shrink-0">
                                        <i class="fas fa-image text-sm"></i>
                                    </div>
                                    <div id="logo-img-wrap" class="hidden w-10 h-10 rounded-lg overflow-hidden border border-primary-700/40 shrink-0">
                                        <img id="logo-preview-img" src="" alt="Logo preview" class="w-full h-full object-cover">
                                    </div>
                                    <span id="logo-preview-name" class="text-[10px] text-slate-500 truncate">No logo uploaded</span>
                                <% } %>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Technologies <span class="text-slate-600 normal-case font-normal">(comma-separated)</span></label>
                            <input type="text" name="technologies" value="<%= project.technologiesRaw %>" required
                                class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all"
                                placeholder="e.g. Node.js, Express, MongoDB, Docker">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">GitHub URL <span class="text-slate-600 normal-case font-normal">(optional)</span></label>
                            <input type="url" name="githubUrl" value="<%= project.githubUrl %>"
                                class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all"
                                placeholder="https://github.com/...">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Display Order <span class="text-slate-600 normal-case font-normal">(optional, lower numbers show first)</span></label>
                            <input type="number" name="order" value="<%= project.order %>" min="0" step="1"
                                class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all"
                                placeholder="e.g. 0">
                        </div>

                        <div class="flex items-center gap-2.5 pt-1">
                            <input type="checkbox" name="featured" id="featured" <%= project.featured ? 'checked' : '' %>
                                class="w-4 h-4 rounded bg-slate-950 border-slate-700 text-primary-600 focus:ring-primary-500 focus:ring-offset-slate-950">
                            <label for="featured" class="text-xs font-semibold text-slate-400 select-none cursor-pointer">Feature this project in the landing page showcase</label>
                        </div>
                    </div>

                    <!-- ====== RIGHT: Images + Description ====== -->
                    <div class="flex flex-col gap-4 border-l border-slate-800/60 pl-8">

                        <!-- Current Images block: height matches Title+Category fields on left -->
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Current Images <span class="text-slate-600 normal-case font-normal">(hover to remove)</span></label>
                                <!-- Upload trigger: compact button, no separate section -->
                                <label for="images-input" class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-primary-600/10 border border-primary-500/30 hover:bg-primary-600 hover:border-primary-500 text-primary-400 hover:text-white text-[10px] font-bold uppercase tracking-wide transition-all cursor-pointer">
                                    <i class="fas fa-plus text-[9px]"></i> Upload New
                                </label>
                                <input type="file" name="images" id="images-input" multiple accept="image/*" class="hidden">
                            </div>

                            <!-- Existing images: 5-col small thumbnails, h-24 aligns with Title+Category -->
                            <div class="grid grid-cols-5 gap-2 bg-slate-950/40 p-2.5 border border-slate-800 rounded-xl h-24 overflow-y-auto content-start" id="existing-images-container">
                                <% if (project.images && project.images.length > 0 && project.images[0] !== 'no-photo.jpg') { %>
                                    <% project.images.forEach((img, idx) => {
                                        const imgSrc = (img.startsWith('http') || img.startsWith('/')) ? img : `/uploads/${img}`;
                                    %>
                                        <div class="relative aspect-square rounded-lg overflow-hidden border border-slate-800 group/img">
                                            <img src="<%= imgSrc %>" class="w-full h-full object-cover">
                                            <input type="hidden" name="existingImages[]" value="<%= img %>">
                                            <button type="button" onclick="this.closest('.relative').remove()"
                                                class="absolute inset-0 bg-red-950/80 opacity-0 group-hover/img:opacity-100 flex items-center justify-center text-red-400 hover:text-red-300 transition-opacity duration-200 cursor-pointer" title="Remove">
                                                <i class="fas fa-trash-alt text-xs"></i>
                                            </button>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <p class="text-slate-500 text-xs italic col-span-5 py-1 text-center">No images currently.</p>
                                <% } %>
                            </div>

                            <!-- New upload previews (same 5-col style) -->
                            <div id="image-previews" class="grid grid-cols-5 gap-2 mt-2 hidden"></div>
                            <p id="image-preview-label" class="text-[10px] text-primary-400 font-semibold mt-1 hidden">↑ New files to upload</p>
                        </div>

                        <!-- Description: starts at same level as Project Type on left -->
                        <div class="flex flex-col flex-1">
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Description</label>
                            <textarea name="description" required
                                class="flex-1 w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all resize-y leading-relaxed min-h-[80px]"
                                placeholder="Describe the project — what it does, the problem it solves, your approach..."><%= project.description %></textarea>
                        </div>
                    </div>
                </div>

                <!-- ====== FULL WIDTH: Live Links ====== -->
                <div class="border-t border-slate-800/60 pt-5 mb-5">
                    <div class="flex items-center justify-between mb-3">
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Live Links <span class="text-slate-600 normal-case font-normal">(optional)</span></label>
                        <button type="button" id="add-link-btn"
                            class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-primary-600/10 border border-primary-500/30 hover:bg-primary-600 hover:border-primary-500 text-primary-400 hover:text-white text-[10px] font-bold uppercase tracking-wide transition-all cursor-pointer">
                            <i class="fas fa-plus text-[9px]"></i> Add Link
                        </button>
                    </div>
                    <div id="live-urls-container" class="space-y-2">
                        <% if (project.liveUrls && project.liveUrls.length > 0) { %>
                            <% project.liveUrls.forEach((url, index) => { %>
                                <div class="flex gap-2.5 items-center bg-slate-950/40 border border-slate-800 rounded-xl px-3.5 py-2.5">
                                    <input type="text" name="liveUrls[<%= index %>][label]" value="<%= url.label %>"
                                        class="w-1/4 bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all"
                                        placeholder="Label, e.g. App Portal">
                                    <input type="url" name="liveUrls[<%= index %>][link]" value="<%= url.link %>"
                                        class="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all"
                                        placeholder="https://...">
                                    <button type="button" class="remove-link-btn w-7 h-7 rounded-lg bg-red-600/10 border border-red-500/30 hover:bg-red-600 hover:text-white text-red-400 flex items-center justify-center transition-all shrink-0 cursor-pointer" title="Remove">
                                        <i class="fas fa-trash-alt text-[10px]"></i>
                                    </button>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="flex gap-2.5 items-center bg-slate-950/40 border border-slate-800 rounded-xl px-3.5 py-2.5">
                                <input type="text" name="liveUrls[0][label]"
                                    class="w-1/4 bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all"
                                    placeholder="Label, e.g. Live Demo">
                                <input type="url" name="liveUrls[0][link]"
                                    class="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all"
                                    placeholder="https://...">
                                <button type="button" class="remove-link-btn w-7 h-7 rounded-lg bg-red-600/10 border border-red-500/30 hover:bg-red-600 hover:text-white text-red-400 flex items-center justify-center transition-all shrink-0 cursor-pointer" title="Remove">
                                    <i class="fas fa-trash-alt text-[10px]"></i>
                                </button>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Submit -->
                <div class="pt-5 border-t border-slate-800/60">
                    <button type="submit" class="w-full btn-primary py-4 text-sm font-bold tracking-wide shadow-xl shadow-primary-500/20 rounded-xl hover:shadow-primary-500/40 hover:scale-[1.01] active:scale-[0.99] transition-all duration-200 flex items-center justify-center gap-2">
                        <i class="fas fa-save text-base"></i> Update Project
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        // Image upload previews (5-col small grid)
        const imageInput = document.getElementById('images-input');
        const previews   = document.getElementById('image-previews');
        const previewLbl = document.getElementById('image-preview-label');

        if (imageInput && previews) {
            imageInput.addEventListener('change', (e) => {
                previews.innerHTML = '';
                const files = e.target.files;
                if (files.length > 0) {
                    previews.classList.remove('hidden');
                    previewLbl.classList.remove('hidden');
                    Array.from(files).slice(0, 8).forEach(file => {
                        const reader = new FileReader();
                        reader.onload = (ev) => {
                            const wrap = document.createElement('div');
                            wrap.className = 'relative aspect-square rounded-lg overflow-hidden border border-primary-700/40 bg-slate-950';
                            const img = document.createElement('img');
                            img.src = ev.target.result;
                            img.className = 'w-full h-full object-cover';
                            wrap.appendChild(img);
                            previews.appendChild(wrap);
                        };
                        reader.readAsDataURL(file);
                    });
                } else {
                    previews.classList.add('hidden');
                    previewLbl.classList.add('hidden');
                }
            });
        }

        // Logo preview
        const logoInput       = document.getElementById('logo-input');
        const logoPlaceholder = document.getElementById('logo-placeholder');
        const logoImgWrap     = document.getElementById('logo-img-wrap');
        const logoPreviewImg  = document.getElementById('logo-preview-img');
        const logoPreviewName = document.getElementById('logo-preview-name');
        if (logoInput) {
            logoInput.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        if (logoPlaceholder) logoPlaceholder.classList.add('hidden');
                        if (logoImgWrap) logoImgWrap.classList.remove('hidden');
                        if (logoPreviewImg) logoPreviewImg.src = ev.target.result;
                        if (logoPreviewName) { logoPreviewName.textContent = file.name; logoPreviewName.className = 'text-[10px] text-slate-300 truncate'; }
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        // Dynamic Live Links
        const linksContainer = document.getElementById('live-urls-container');
        const addLinkBtn     = document.getElementById('add-link-btn');
        let linkIndex = parseInt('<%= (project.liveUrls && project.liveUrls.length > 0) ? project.liveUrls.length : 1 %>') || 1;

        if (linksContainer) {
            linksContainer.querySelectorAll('.remove-link-btn').forEach(btn => {
                btn.addEventListener('click', () => btn.closest('.flex').remove());
            });
        }

        if (addLinkBtn && linksContainer) {
            addLinkBtn.addEventListener('click', () => {
                const row = document.createElement('div');
                row.className = 'flex gap-2.5 items-center bg-slate-950/40 border border-slate-800 rounded-xl px-3.5 py-2.5 animate-fade-in';
                row.innerHTML = `
                    <input type="text" name="liveUrls[${linkIndex}][label]"
                        class="w-1/4 bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all"
                        placeholder="Label, e.g. App Portal">
                    <input type="url" name="liveUrls[${linkIndex}][link]"
                        class="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all"
                        placeholder="https://...">
                    <button type="button" class="remove-link-btn w-7 h-7 rounded-lg bg-red-600/10 border border-red-500/30 hover:bg-red-600 hover:text-white text-red-400 flex items-center justify-center transition-all shrink-0 cursor-pointer" title="Remove">
                        <i class="fas fa-trash-alt text-[10px]"></i>
                    </button>
                `;
                linksContainer.appendChild(row);
                row.querySelector('input[type="text"]').focus();
                row.querySelector('.remove-link-btn').addEventListener('click', () => row.remove());
                linkIndex++;
            });
        }
    });
</script>
