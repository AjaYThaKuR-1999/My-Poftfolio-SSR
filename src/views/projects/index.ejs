<section class="pt-32 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Our Portfolio</h1>
            <p class="text-slate-400 text-lg max-w-2xl mx-auto">
                Explore our latest backend architectures, API designs, and distributed system solutions built for scale and performance.
            </p>
        </div>

        <% if (projects.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% projects.forEach(project => { %>
                    <div class="glass-card group overflow-hidden p-0 flex flex-col h-full hover:border-primary-500/50 transition-all duration-500">
                        <!-- Image Container -->
                        <div class="relative h-64 overflow-hidden">
                            <% if (project.image && !project.image.endsWith('no-photo.jpg')) { %>
                                <img src="<%= project.image %>" alt="<%= project.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center text-slate-700 bg-slate-900/50">
                                    <i class="fas fa-code text-4xl"></i>
                                </div>
                            <% } %>
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-60"></div>
                            <div class="absolute top-4 right-4">
                                <span class="px-3 py-1 bg-primary-600 text-white text-xs font-bold rounded-full uppercase"><%= project.category %></span>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-6 flex flex-col flex-grow">
                            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary-400 transition-colors"><%= project.title %></h3>
                            <p class="text-slate-400 text-sm mb-6 line-clamp-3 leading-relaxed"><%= project.description %></p>
                            
                            <div class="flex flex-wrap gap-2 mb-8">
                                <% project.technologies.forEach(tech => { %>
                                    <span class="px-2 py-1 bg-slate-800 rounded text-[10px] font-semibold text-slate-300 uppercase tracking-wider"><%= tech %></span>
                                <% }); %>
                            </div>

                            <div class="mt-auto flex items-center justify-between">
                                <a href="/projects/<%= project._id %>" class="text-primary-500 font-bold text-sm hover:text-primary-400 transition-colors flex items-center gap-2">
                                    Read Case Study <i class="fas fa-chevron-right text-[10px]"></i>
                                </a>
                                <div class="flex gap-4">
                                    <% if (project.githubUrl) { %>
                                        <a href="<%= project.githubUrl %>" target="_blank" class="text-slate-500 hover:text-white transition-colors"><i class="fab fa-github text-lg"></i></a>
                                    <% } %>
                                    <% if (project.liveUrl) { %>
                                        <a href="<%= project.liveUrl %>" target="_blank" class="text-slate-500 hover:text-white transition-colors"><i class="fas fa-external-link-alt text-lg"></i></a>
                                    <% } %>
                                </div>
                            </div>
                            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                                <div class="mt-4 pt-4 border-t border-slate-800 flex justify-end">
                                    <a href="/projects/<%= project._id %>/edit" class="text-xs font-semibold text-amber-500 hover:text-amber-400 flex items-center gap-1.5 transition-colors">
                                        <i class="fas fa-edit"></i> Edit Project
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="text-center py-20 glass-card">
                <div class="text-slate-500 text-5xl mb-6"><i class="fas fa-code"></i></div>
                <h3 class="text-xl font-bold text-white mb-2">No projects found</h3>
                <p class="text-slate-400 mb-8">We are currently working on some amazing projects. Check back soon!</p>
                <a href="/" class="btn-primary">Return Home</a>
            </div>
        <% } %>
    </div>
</section>
