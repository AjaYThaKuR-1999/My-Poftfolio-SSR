<section class="pt-32 pb-20 relative overflow-hidden">
    <!-- Background Glows -->
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-primary-600/10 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Back navigation -->
        <div class="mb-10">
            <a href="/projects" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors text-sm font-semibold">
                <i class="fas fa-arrow-left"></i> Back to Portfolio
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            <!-- Left Column: Case Study Details -->
            <div class="lg:col-span-2 space-y-8">
                <div class="glass-card p-8 md:p-10 border-slate-700/50">
                    <div class="flex flex-wrap gap-3 mb-6 items-center">
                        <span class="px-3 py-1 bg-primary-600/20 text-primary-400 border border-primary-500/30 text-xs font-bold rounded-full uppercase tracking-wider">
                            <%= project.category %>
                        </span>
                        <% if (project.projectType === 'professional') { %>
                            <span class="px-3 py-1 bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 text-xs font-bold rounded-full uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fas fa-briefcase"></i> Professional Work
                            </span>
                        <% } else { %>
                            <span class="px-3 py-1 bg-blue-600/20 text-blue-400 border border-blue-500/30 text-xs font-bold rounded-full uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fas fa-user-cog"></i> Personal Project
                            </span>
                        <% } %>
                    </div>
                    <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight mb-6"><%= project.title %></h1>
                    
                    <div class="h-[2px] bg-gradient-to-r from-primary-500 to-transparent mb-8"></div>

                    <h3 class="text-xl font-bold text-white mb-4">Project Overview</h3>
                    <p class="text-slate-300 leading-relaxed text-base mb-8 whitespace-pre-line">
                        <%= project.description %>
                    </p>
                </div>
            </div>

            <!-- Right Column: Sidebar / Meta Info -->
            <div class="space-y-8">
                <!-- Preview card -->
                <div class="glass-card overflow-hidden p-0 border-slate-700/50">
                    <div class="h-56 relative overflow-hidden bg-slate-900">
                        <% if (project.image && !project.image.endsWith('no-photo.jpg')) { %>
                            <img src="<%= project.image %>" alt="<%= project.title %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center text-slate-750">
                                <i class="fas fa-code text-5xl"></i>
                            </div>
                        <% } %>
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
                    </div>
                    
                    <div class="p-6 space-y-6">
                        <!-- Tech Badges -->
                        <div>
                            <h4 class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-3">Technologies Built With</h4>
                            <div class="flex flex-wrap gap-2">
                                <% project.technologies.forEach(tech => { %>
                                    <span class="px-3 py-1 bg-slate-950 border border-slate-800 rounded-md text-xs font-semibold text-slate-300 uppercase tracking-wider">
                                        <%= tech %>
                                    </span>
                                <% }); %>
                            </div>
                        </div>

                        <div class="h-[1px] bg-slate-800"></div>

                        <!-- Project links -->
                        <div class="space-y-4">
                            <% if (project.githubUrl) { %>
                                <a href="<%= project.githubUrl %>" target="_blank" class="w-full inline-flex items-center justify-center gap-3 bg-slate-900 border border-slate-800 hover:border-slate-700 text-white font-bold py-3 px-4 rounded-lg transition-all">
                                    <i class="fab fa-github text-lg"></i> View Source Code
                                </a>
                            <% } %>
                            <% if (project.liveUrl) { %>
                                <a href="<%= project.liveUrl %>" target="_blank" class="w-full inline-flex items-center justify-center gap-3 btn-primary font-bold py-3 px-4 rounded-lg transition-all">
                                    <i class="fas fa-external-link-alt"></i> Visit Live Application
                                </a>
                            <% } %>
                            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                                <a href="/projects/<%= project._id %>/edit" class="w-full inline-flex items-center justify-center gap-3 bg-amber-600 hover:bg-amber-500 text-white font-bold py-3 px-4 rounded-lg transition-all">
                                    <i class="fas fa-edit text-lg"></i> Edit Project Details
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Assistance CTA -->
                <div class="glass-card border-slate-700/50 text-center">
                    <div class="w-12 h-12 bg-primary-600/20 rounded-full flex items-center justify-center text-primary-500 mx-auto mb-4 text-xl">
                        <i class="fas fa-question-circle"></i>
                    </div>
                    <h4 class="text-lg font-bold text-white mb-2">Need help with similar systems?</h4>
                    <p class="text-slate-400 text-xs mb-6">
                        As a backend developer, I design custom high-capacity infrastructures, APIs, and databases.
                    </p>
                    <a href="/dashboard" class="w-full inline-block text-xs font-bold text-primary-500 hover:text-primary-450 border border-primary-500/30 hover:border-primary-500/60 rounded-lg py-3 px-4 transition-all">
                        Request Assistance / Query
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
