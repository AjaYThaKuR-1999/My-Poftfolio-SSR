<%
    const hasImages = project.images && project.images.length > 0 && project.images[0] !== 'no-photo.jpg';
    let mainImgSrc = '/uploads/no-photo.jpg';
    if (hasImages) {
        const firstImg = project.images[0];
        mainImgSrc = (firstImg.startsWith('http') || firstImg.startsWith('/')) ? firstImg : `/uploads/${firstImg}`;
    }
    const hasLinks = (project.githubUrl) || (project.liveUrls && project.liveUrls.some(u => u.link));
%>

<section class="pt-24 pb-16 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[450px] h-[450px] bg-primary-600/4 rounded-full blur-[110px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-blue-600/4 rounded-full blur-[90px] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

        <!-- ── TOP NAV ─────────────────────────────────── -->
        <div class="mb-10">
            <a href="/projects" class="inline-flex items-center gap-2 text-slate-400 hover:text-white text-sm font-semibold group transition-colors">
                <i class="fas fa-arrow-left text-xs group-hover:-translate-x-0.5 transition-transform"></i> Back to Projects
            </a>
        </div>

        <!-- ── HEADER BLOCK ────────────────────────────── -->
        <div class="mb-8">
            <!-- Title row: logo + title on left, edit button on right -->
            <div class="flex items-start justify-between gap-4 mb-3">
                <div class="flex items-end gap-4 min-w-0">
                    <% if (project.logoUrl) { %>
                        <div class="shrink-0 w-20 h-20 rounded-2xl bg-slate-900 border border-primary-500/25 overflow-hidden"
                             style="box-shadow: 0 0 0 4px rgba(99,102,241,0.06), 0 8px 24px -4px rgba(0,0,0,0.5);">
                            <img src="<%= project.logoUrl %>" alt="<%= project.title %> logo"
                                 class="w-full h-full object-contain">
                        </div>
                    <% } %>
                    <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-tight min-w-0 pb-0.5">
                        <%= project.title %>
                    </h1>
                </div>
                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                    <a href="/projects/<%= project._id %>/edit"
                        class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 bg-amber-600/10 hover:bg-amber-600 border border-amber-500/30 hover:border-amber-500 text-amber-400 hover:text-white rounded-lg text-xs font-bold transition-all mt-1">
                        <i class="fas fa-edit text-[10px]"></i> Edit Project
                    </a>
                <% } %>
            </div>

            <!-- Badges: category, type, featured -->
            <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-primary-950/50 border border-primary-800/60 text-primary-400 rounded-md text-[10px] font-bold uppercase tracking-wider">
                    <%= project.category %>
                </span>
                <% if (project.projectType === 'professional') { %>
                    <span class="px-3 py-1 bg-emerald-950/50 border border-emerald-800/60 text-emerald-400 rounded-md text-[10px] font-bold uppercase tracking-wider inline-flex items-center gap-1.5">
                        <i class="fas fa-briefcase text-[9px]"></i> Professional
                    </span>
                <% } else { %>
                    <span class="px-3 py-1 bg-blue-950/50 border border-blue-800/60 text-blue-400 rounded-md text-[10px] font-bold uppercase tracking-wider inline-flex items-center gap-1.5">
                        <i class="fas fa-code text-[9px]"></i> Personal
                    </span>
                <% } %>
                <% if (project.featured) { %>
                    <span class="px-3 py-1 bg-yellow-950/50 border border-yellow-800/60 text-yellow-400 rounded-md text-[10px] font-bold uppercase tracking-wider inline-flex items-center gap-1.5">
                        <i class="fas fa-star text-[9px]"></i> Featured
                    </span>
                <% } %>
            </div>

            <!-- Tech Stack -->
            <div class="flex flex-wrap gap-1.5">
                <% project.technologies.forEach(tech => { %>
                    <span class="px-2 py-0.5 bg-slate-900 border border-slate-800 text-slate-400 rounded text-[10px] font-bold uppercase tracking-wider"><%= tech %></span>
                <% }); %>
            </div>
        </div>

        <!-- ── MAIN CARD ───────────────────────────────── -->
        <div class="glass-card border-slate-700/50 overflow-hidden">

            <!-- Description (always first inside card) -->
            <div class="px-6 md:px-10 pt-8 pb-6">
                <h2 class="text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-3">About this Project</h2>
                <p class="text-slate-300 text-[15px] leading-[1.85] whitespace-pre-line"><%= project.description %></p>
            </div>

            <!-- Gallery (below description, only if images exist) -->
            <% if (hasImages) { %>
                <div class="border-t border-slate-800/60 mt-2">
                    <!-- Main image -->
                    <div class="bg-slate-950/60" style="max-height: 440px; overflow: hidden;">
                        <img id="gallery-main-image"
                            src="<%= mainImgSrc %>"
                            alt="<%= project.title %>"
                            class="w-full object-cover transition-opacity duration-200"
                            style="max-height: 440px; object-position: top;">
                    </div>
                    <!-- Thumbnails (only if more than one image) -->
                    <% if (project.images.length > 1) { %>
                        <div class="flex gap-2 p-3 overflow-x-auto bg-slate-950/40 custom-scrollbar">
                            <% project.images.forEach((img, idx) => {
                                const thumbSrc = (img.startsWith('http') || img.startsWith('/')) ? img : `/uploads/${img}`;
                            %>
                                <button type="button"
                                    onclick="changeGalleryImage(this, '<%= thumbSrc %>')"
                                    class="gallery-thumb-btn shrink-0 w-16 h-11 rounded-lg overflow-hidden border transition-all focus:outline-none cursor-pointer <%= idx === 0 ? 'border-primary-500 ring-1 ring-primary-500/40' : 'border-slate-800 hover:border-slate-600' %>">
                                    <img src="<%= thumbSrc %>" alt="Screenshot <%= idx + 1 %>" class="w-full h-full object-cover">
                                </button>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- Links (only rendered if at least one link exists) -->
            <% if (hasLinks) { %>
                <div class="px-6 md:px-10 pt-8 pb-8 border-t border-slate-800/60 mt-2">
                    <h2 class="text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-4">Project Links</h2>
                    <div class="flex flex-wrap gap-3">
                        <% if (project.githubUrl) { %>
                            <a href="<%= project.githubUrl %>" target="_blank" rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-900 hover:bg-slate-800 border border-slate-700 hover:border-slate-600 text-white rounded-xl text-xs font-bold transition-all">
                                <i class="fab fa-github text-sm"></i> Source Code
                            </a>
                        <% } %>
                        <% if (project.liveUrls && project.liveUrls.length > 0) { %>
                            <% project.liveUrls.forEach(url => { %>
                                <% if (url.link) { %>
                                    <a href="<%= url.link %>" target="_blank" rel="noopener noreferrer"
                                        class="inline-flex items-center gap-2 px-5 py-2.5 btn-primary rounded-xl text-xs font-bold transition-all shadow-lg shadow-primary-950/30">
                                        <i class="fas fa-external-link-alt text-[10px]"></i> <%= url.label || 'Live Demo' %>
                                    </a>
                                <% } %>
                            <% }); %>
                        <% } %>
                    </div>
                </div>
            <% } %>

        </div>

    </div>
</section>

<script>
    function changeGalleryImage(btn, src) {
        const mainImg = document.getElementById('gallery-main-image');
        if (!mainImg) return;

        mainImg.style.opacity = '0';
        mainImg.style.transition = 'opacity 0.15s';

        document.querySelectorAll('.gallery-thumb-btn').forEach(b => {
            b.classList.remove('border-primary-500', 'ring-1', 'ring-primary-500/40');
            b.classList.add('border-slate-800');
        });
        btn.classList.remove('border-slate-800');
        btn.classList.add('border-primary-500', 'ring-1', 'ring-primary-500/40');

        setTimeout(() => {
            mainImg.src = src;
            mainImg.style.opacity = '1';
        }, 150);
    }
</script>
