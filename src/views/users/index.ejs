<section class="pt-32 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb & Back Link -->
        <div class="mb-6 animate-fade-in">
            <a href="/dashboard" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors text-xs font-semibold uppercase tracking-wider">
                <i class="fas fa-arrow-left text-[10px]"></i> Back to Dashboard
            </a>
        </div>

        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-6 border-b border-slate-800/80 pb-6 animate-fade-in">
            <div>
                <h1 class="text-3xl font-extrabold text-white mb-2 tracking-tight flex items-center gap-3">
                    <i class="fas fa-users text-primary-500"></i> Registered Members
                </h1>
                <p class="text-slate-450 text-sm">Excludes administrator accounts. Currently displaying total registered: <span class="text-white font-bold"><%= totalUsers %></span></p>
            </div>
        </div>

        <%- include('../partials/flash') %>

        <!-- Dedicated Members Table (Admin Only) -->
        <div class="glass-card mb-8 animate-fade-in">
            <% if (users.length > 0) { %>
                <div class="overflow-x-auto -mx-6 px-6">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-800 text-slate-500 text-[10px] uppercase font-bold tracking-wider">
                                <th class="pb-4 px-6 font-bold text-left">Member</th>
                                <th class="pb-4 px-6 font-bold text-left">Email Address</th>
                                <th class="pb-4 px-6 font-bold text-left">Professional Role</th>
                                <th class="pb-4 px-6 font-bold text-left">Seeking</th>
                                <th class="pb-4 px-6 font-bold text-left">Registered At</th>
                                <th class="pb-4 px-6 font-bold text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="text-xs">
                            <% users.forEach(member => { %>
                                <tr class="border-b border-slate-900/50 hover:bg-slate-950/35 transition-colors group">
                                    <td class="py-4 px-6 font-semibold text-white">
                                        <div class="flex items-center gap-3">
                                            <% if (member.profilePicture) { %>
                                                <img src="<%= member.profilePicture %>" alt="<%= member.name %>" class="w-9 h-9 rounded-full object-cover shrink-0">
                                            <% } else { %>
                                                <div class="w-9 h-9 rounded-full bg-primary-600/10 text-primary-400 flex items-center justify-center font-bold text-sm shrink-0">
                                                    <%= member.name.charAt(0).toUpperCase() %>
                                                </div>
                                            <% } %>
                                            <div>
                                                <div class="font-semibold text-white group-hover:text-primary-450 transition-colors"><%= member.name %></div>
                                                <div class="text-[10px] text-slate-500"><%= member.location || 'No Location' %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6 text-slate-350 text-xs font-mono break-all"><%= member.email %></td>
                                    <td class="py-4 px-6">
                                        <% 
                                            let typeText = 'Other';
                                            let typeColor = 'bg-slate-900 text-slate-400 border border-slate-800';
                                            if (member.userType === 'developer') { typeText = 'Developer'; typeColor = 'bg-indigo-950/45 border border-indigo-900 text-indigo-400'; }
                                            else if (member.userType === 'recruiter') { typeText = 'Recruiter'; typeColor = 'bg-pink-950/45 border border-pink-900 text-pink-400'; }
                                            else if (member.userType === 'project_provider') { typeText = 'Project Provider'; typeColor = 'bg-blue-950/45 border border-blue-900 text-blue-400'; }
                                            else if (member.userType === 'hobbyist') { typeText = 'Hobbyist'; typeColor = 'bg-emerald-950/45 border border-emerald-900 text-emerald-400'; }
                                        %>
                                        <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider <%= typeColor %>">
                                            <%= typeText %>
                                        </span>
                                    </td>
                                    <td class="py-4 px-6">
                                        <%
                                            let seekText = 'Other';
                                            let seekColor = 'bg-slate-900 text-slate-400 border border-slate-800';
                                            if (member.seeking === 'hiring_talent') { seekText = 'Hiring Talent'; seekColor = 'bg-rose-950/45 border border-rose-900 text-rose-400'; }
                                            else if (member.seeking === 'freelance_work') { seekText = 'Freelance Work'; seekColor = 'bg-emerald-950/45 border border-emerald-900 text-emerald-400'; }
                                            else if (member.seeking === 'collaboration') { seekText = 'Collaboration'; seekColor = 'bg-sky-950/45 border border-sky-900 text-sky-400'; }
                                            else if (member.seeking === 'networking') { seekText = 'Networking'; seekColor = 'bg-purple-950/45 border border-purple-900 text-purple-400'; }
                                            else if (member.seeking === 'exploration') { seekText = 'Exploration'; seekColor = 'bg-amber-950/45 border border-amber-900 text-amber-400'; }
                                        %>
                                        <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider <%= seekColor %>">
                                            <%= seekText %>
                                        </span>
                                    </td>
                                    <td class="py-4 px-6 text-slate-400">
                                        <%= new Date(member.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <a href="/users/<%= member._id %>"
                                            class="px-3 py-1.5 bg-slate-900 border border-slate-800 hover:border-primary-500 hover:text-white rounded-lg text-slate-350 transition-all text-[11px] font-bold cursor-pointer inline-flex items-center gap-1.5">
                                            <i class="far fa-eye text-primary-500"></i> View Details
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                <% if (totalPages > 1) { %>
                    <div class="flex justify-between items-center mt-8 pt-6 border-t border-slate-850">
                        <p class="text-slate-500 text-xs">
                            Showing Page <span class="text-slate-300 font-bold"><%= currentPage %></span> of <span class="text-slate-300 font-bold"><%= totalPages %></span>
                        </p>
                        <div class="flex items-center gap-1.5">
                            <% if (currentPage > 1) { %>
                                <a href="?page=<%= currentPage - 1 %>" class="px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-300 hover:border-primary-500 hover:text-white font-semibold transition-all text-xs flex items-center gap-1">
                                    <i class="fas fa-chevron-left text-[10px]"></i> Prev
                                </a>
                            <% } else { %>
                                <button disabled class="px-3 py-1.5 bg-slate-950 border border-slate-900 rounded-lg text-slate-600 font-semibold text-xs opacity-50 cursor-not-allowed flex items-center gap-1">
                                    <i class="fas fa-chevron-left text-[10px]"></i> Prev
                                </button>
                            <% } %>

                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <% if (i === currentPage) { %>
                                    <span class="px-3 py-1.5 bg-primary-600 rounded-lg text-white font-bold text-xs border border-primary-500">
                                        <%= i %>
                                    </span>
                                <% } else { %>
                                    <a href="?page=<%= i %>" class="px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-350 hover:border-primary-500 hover:text-white font-bold transition-all text-xs">
                                        <%= i %>
                                    </a>
                                <% } %>
                            <% } %>

                            <% if (currentPage < totalPages) { %>
                                <a href="?page=<%= currentPage + 1 %>" class="px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-300 hover:border-primary-500 hover:text-white font-semibold transition-all text-xs flex items-center gap-1">
                                    Next <i class="fas fa-chevron-right text-[10px]"></i>
                                </a>
                            <% } else { %>
                                <button disabled class="px-3 py-1.5 bg-slate-950 border border-slate-900 rounded-lg text-slate-600 font-semibold text-xs opacity-50 cursor-not-allowed flex items-center gap-1">
                                    Next <i class="fas fa-chevron-right text-[10px]"></i>
                                </button>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            <% } else { %>
                <p class="text-slate-500 text-xs italic text-center py-10">No users registered yet.</p>
            <% } %>
        </div>
    </div>
</section>


