<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title != 'undefined' ? title : 'Portfolio' %> | Backend Architect</title>
    <meta name="description" content="<%= typeof description != 'undefined' ? description : 'Showcase of backend engineering excellence' %>">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- Font Awesome (Optional) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 font-sans selection:bg-primary-500/30 selection:text-primary-200" data-user-logged-in="<%= typeof user !== 'undefined' && user ? 'true' : 'false' %>">
    
    <%- include('../partials/header') %>

    <main class="min-h-screen">
        <%- body %>
    </main>

    <%- include('../partials/footer') %>

    <!-- Global Scripts -->
    <script src="/js/main.js"></script>
</body>
</html>
