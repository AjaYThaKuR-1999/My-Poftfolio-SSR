<section class="pt-[110px] pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Premium Welcome Banner (Glassmorphic & Animated) -->
        <div
            class="relative overflow-hidden bg-gradient-to-r from-slate-900/60 via-slate-900/40 to-slate-950/50 border border-slate-800/60 rounded-3xl py-4 px-6 md:py-5 md:px-8 flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 shadow-2xl animate-fade-in">
            <!-- Ambient banner background glows -->
            <div
                class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 w-[300px] h-[300px] bg-primary-500/10 rounded-full blur-[80px] pointer-events-none">
            </div>
            <div
                class="absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/4 w-[240px] h-[240px] bg-indigo-500/5 rounded-full blur-[60px] pointer-events-none">
            </div>

            <div class="flex items-center gap-4.5 relative z-10">
                <div
                    class="w-14 h-14 bg-gradient-to-br from-primary-500/20 to-indigo-600/30 border border-primary-500/30 rounded-2xl flex items-center justify-center text-white text-2xl shadow-lg shadow-primary-500/10 shrink-0 select-none">
                    👋
                </div>
                <div>
                    <h1
                        class="text-2xl md:text-3xl font-extrabold text-white tracking-tight mb-1.5 flex items-center gap-2">
                        Welcome back, <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-indigo-400 font-black">
                            <%= user.name %>
                        </span>!
                    </h1>
                    <p class="text-slate-400 text-sm leading-relaxed max-w-2xl">
                        Access your profile details, manage connections, and stay updated with the latest community
                        announcements.
                    </p>
                </div>
            </div>

            <div class="flex flex-wrap gap-3.5 shrink-0 relative z-10">
                <% if (user.role==='admin' ) { %>
                    <!-- Platform Visits Metric Block -->
                    <div class="px-5 py-3 bg-gradient-to-r from-primary-950/60 to-slate-900/60 border border-primary-900/30 rounded-xl text-primary-400 text-xs font-bold flex items-center gap-2 shadow-md select-none">
                        <i class="fas fa-eye text-primary-500 text-xs animate-pulse"></i>
                        <span>Platform Visits: <strong class="text-white font-extrabold text-[13.5px] ml-1"><%= globalVisits %></strong></span>
                    </div>
                    <a href="/users"
                        class="px-5 py-3 bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 hover:text-white rounded-xl text-slate-300 transition-all text-xs font-bold flex items-center gap-2 shadow-md">
                        <i class="fas fa-users text-primary-500 text-xs"></i> View Users
                    </a>
                    <a href="/projects"
                        class="btn-primary px-5 py-3 rounded-xl text-xs font-bold flex items-center gap-2 shadow-lg shadow-primary-950/45">
                        <i class="fas fa-project-diagram text-xs"></i> View Projects
                    </a>
                    <% } %>
            </div>
        </div>

        <%- include('../partials/flash') %>

            <!-- Rebalanced 2-Column Section: Profile details vs. Announcements -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12 items-stretch">
                <!-- Left Column: Profile Card (col-span-5) -->
                <div class="lg:col-span-5">
                    <!-- Profile Card -->
                    <div class="glass-card overflow-hidden flex flex-col justify-between relative h-full">
                        <!-- Premium gradient background glow inside card -->
                        <div
                            class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-br from-primary-600/10 via-indigo-600/5 to-transparent border-b border-slate-800/40 pointer-events-none">
                        </div>

                        <!-- Edit Profile Settings Button (Top-Right Absolute) -->
                        <button onclick="openProfileModal()"
                            class="absolute top-4 right-4 z-20 px-3 py-1.5 bg-slate-950/60 hover:bg-primary-600/20 border border-slate-800 hover:border-primary-500/50 text-slate-400 hover:text-primary-400 rounded-xl transition-all cursor-pointer shadow-md flex items-center justify-center gap-1.5 text-[10px] font-bold"
                            title="Edit Profile Settings">
                            <i class="fas fa-user-edit text-[10px]"></i> Edit Profile
                        </button>

                        <div class="relative z-10 flex-1 flex flex-col justify-between">
                            <div>
                                <!-- Profile Header: Brand/Avatar row -->
                                <div class="flex flex-col sm:flex-row items-center gap-6 mb-6">
                                    <!-- Avatar frame with elegant ring background -->
                                    <div
                                        class="relative shrink-0 p-1.5 rounded-3xl bg-slate-950/80 border border-slate-800/80 shadow-2xl">
                                        <% if (user.profilePicture) { %>
                                            <img src="<%= user.profilePicture %>" alt="<%= user.name %>"
                                                class="w-[92px] h-[92px] rounded-2xl object-cover bg-slate-950 border border-slate-800/40">
                                            <% } else { %>
                                                <div
                                                    class="w-[92px] h-[92px] rounded-2xl bg-gradient-to-br from-primary-600 to-indigo-650 flex items-center justify-center text-white text-3xl font-black select-none border border-slate-800/40 shadow-inner">
                                                    <%= user.name.charAt(0).toUpperCase() %>
                                                </div>
                                                <% } %>
                                    </div>

                                    <!-- Name details centered vertically relative to photo -->
                                    <div class="text-center sm:text-left flex-1 min-w-0">
                                        <span
                                            class="inline-flex px-2.5 py-0.5 bg-primary-950/50 border border-primary-900/60 text-primary-400 rounded-md text-[9px] font-bold uppercase tracking-wider mb-2">
                                            <%= user.role==='admin' ? 'Administrator' : 'Community Member' %>
                                        </span>
                                        <h3
                                            class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-primary-300 tracking-tight leading-tight truncate">
                                            <%= user.name %>
                                        </h3>
                                    </div>
                                </div>

                                <!-- Bio Section (Pointer 9) -->
                                <% if (user.bio) { %>
                                    <div
                                        class="mb-6 relative bg-gradient-to-br from-slate-950/40 to-slate-950/15 border border-slate-850/60 px-5 py-4 rounded-2xl shadow-inner">
                                        <div
                                            class="absolute -top-2.5 left-4 px-2 py-0.5 bg-slate-900 border border-slate-800 text-slate-500 rounded text-[9px] uppercase tracking-wider font-bold select-none">
                                            Biography
                                        </div>
                                        <p class="text-slate-300 text-[13.5px] italic leading-relaxed font-medium">
                                            "<%= user.bio %>"
                                        </p>
                                    </div>
                                    <% } %>

                                        <!-- Grid Info (Pointer 7: Larger fonts) -->
                                        <div
                                            class="grid grid-cols-1 sm:grid-cols-2 gap-3 py-5 border-t border-slate-800/60">
                                            <!-- Email -->
                                            <div
                                                class="bg-slate-950/30 border border-slate-900/60 rounded-xl p-3 hover:border-slate-800/80 transition-all flex items-center gap-3">
                                                <div
                                                    class="w-8 h-8 rounded-lg bg-slate-900/85 border border-slate-800 flex items-center justify-center text-primary-400 shrink-0">
                                                    <i class="fas fa-envelope text-xs"></i>
                                                </div>
                                                <div class="min-w-0">
                                                    <span
                                                        class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Email</span>
                                                    <span class="text-white text-[13.5px] block truncate font-medium">
                                                        <%= user.email %>
                                                    </span>
                                                </div>
                                            </div>
                                            <!-- Location -->
                                            <div
                                                class="bg-slate-950/30 border border-slate-900/60 rounded-xl p-3 hover:border-slate-800/80 transition-all flex items-center gap-3">
                                                <div
                                                    class="w-8 h-8 rounded-lg bg-slate-900/85 border border-slate-800 flex items-center justify-center text-primary-400 shrink-0">
                                                    <i class="fas fa-map-marker-alt text-xs"></i>
                                                </div>
                                                <div class="min-w-0">
                                                    <span
                                                        class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Location</span>
                                                    <span
                                                        class="text-slate-300 text-[13.5px] block truncate font-medium">
                                                        <%= user.location || 'Not Specified' %>
                                                    </span>
                                                </div>
                                            </div>
                                            <!-- User Role Type -->
                                            <div
                                                class="bg-slate-950/30 border border-slate-900/60 rounded-xl p-3 hover:border-slate-800/80 transition-all flex items-center gap-3">
                                                <div
                                                    class="w-8 h-8 rounded-lg bg-slate-900/85 border border-slate-800 flex items-center justify-center text-primary-400 shrink-0">
                                                    <i class="fas fa-user-tag text-xs"></i>
                                                </div>
                                                <div class="min-w-0">
                                                    <span
                                                        class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Account
                                                        Type</span>
                                                    <span
                                                        class="text-slate-300 text-[13.5px] block truncate font-medium">
                                                        <%= user.userType ? user.userType.charAt(0).toUpperCase() +
                                                            user.userType.slice(1).replace('_', ' ' ) : `Not Specified`
                                                            %>
                                                    </span>
                                                </div>
                                            </div>
                                            <!-- Seeking Intent -->
                                            <div
                                                class="bg-slate-950/30 border border-slate-900/60 rounded-xl p-3 hover:border-slate-800/80 transition-all flex items-center gap-3">
                                                <div
                                                    class="w-8 h-8 rounded-lg bg-slate-900/85 border border-slate-800 flex items-center justify-center text-primary-400 shrink-0">
                                                    <i class="fas fa-search text-xs"></i>
                                                </div>
                                                <div class="min-w-0">
                                                    <span
                                                        class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Seeking</span>
                                                    <span
                                                        class="text-slate-300 text-[13.5px] block truncate font-medium">
                                                        <%= user.seeking ? user.seeking.split('_').map(w=>
                                                            w.charAt(0).toUpperCase() + w.slice(1)).join(' ') : `Not
                                                            Specified` %>
                                                    </span>
                                                </div>
                                            </div>
                                            <!-- Member Since (Full width) -->
                                            <div
                                                class="bg-slate-950/30 border border-slate-900/60 rounded-xl p-3 hover:border-slate-800/80 transition-all flex items-center gap-3 sm:col-span-2">
                                                <div
                                                    class="w-8 h-8 rounded-lg bg-slate-900/85 border border-slate-800 flex items-center justify-center text-primary-400 shrink-0">
                                                    <i class="fas fa-calendar-alt text-xs"></i>
                                                </div>
                                                <div class="min-w-0">
                                                    <span
                                                        class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Member
                                                        Since</span>
                                                    <span
                                                        class="text-slate-300 text-[13.5px] block truncate font-medium">
                                                        <%= new Date(user.createdAt).toLocaleDateString(undefined, {
                                                            year: 'numeric' , month: 'long' , day: 'numeric' }) %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                            </div>

                            <div>
                                <% if (user.role==='admin' ) { %>
                                    <!-- Resume Section for Admin (Pointer 5 & 6) -->
                                    <div class="mt-4 pt-4 border-t border-slate-800/60">
                                        <span
                                            class="text-[11px] text-slate-500 font-bold uppercase tracking-wider block mb-2.5">My
                                            Professional Resume</span>
                                        <% if (user.resume) { %>
                                            <div class="space-y-3">
                                                <a href="/dashboard/resume/download"
                                                    class="w-full py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md shadow-primary-950/20">
                                                    <i class="fas fa-file-download"></i> Download Resume
                                                </a>
                                                <details
                                                    class="group border border-slate-800 rounded-xl bg-slate-950/30 overflow-hidden">
                                                    <summary
                                                        class="list-none flex justify-between items-center px-4 py-2.5 text-xs text-slate-400 font-semibold cursor-pointer hover:bg-slate-900/50 hover:text-white select-none transition-all">
                                                        <span>Update Resume File</span>
                                                        <i
                                                            class="fas fa-chevron-down text-[10px] transform group-open:rotate-180 transition-transform"></i>
                                                    </summary>
                                                    <div class="p-4 border-t border-slate-850/40 bg-slate-950/40">
                                                        <form action="/dashboard/resume" method="POST"
                                                            enctype="multipart/form-data" class="space-y-3">
                                                            <div>
                                                                <label
                                                                    class="block text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Select
                                                                    File (PDF, DOC, DOCX - Max 10MB)</label>
                                                                <input type="file" name="resume"
                                                                    accept=".pdf,.doc,.docx" required
                                                                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-slate-450 file:mr-3 file:py-1 file:px-2.5 file:rounded file:border-0 file:text-[9px] file:font-bold file:bg-primary-600/10 file:text-primary-400 hover:file:bg-primary-600/20 file:cursor-pointer transition-all">
                                                            </div>
                                                            <button type="submit"
                                                                class="w-full py-2 bg-slate-900 border border-slate-800 hover:border-primary-500 hover:text-white text-xs font-semibold rounded-lg transition-all cursor-pointer">
                                                                Upload & Replace
                                                            </button>
                                                        </form>
                                                    </div>
                                                </details>
                                            </div>
                                            <% } else { %>
                                                <div class="p-4 border border-slate-800 rounded-xl bg-slate-950/30">
                                                    <form action="/dashboard/resume" method="POST"
                                                        enctype="multipart/form-data" class="space-y-3">
                                                        <div>
                                                            <label
                                                                class="block text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Upload
                                                                Resume (PDF, DOC, DOCX - Max 10MB)</label>
                                                            <input type="file" name="resume" accept=".pdf,.doc,.docx"
                                                                required
                                                                class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-slate-455 file:mr-3 file:py-1 file:px-2.5 file:rounded file:border-0 file:text-[9px] file:font-bold file:bg-primary-600/10 file:text-primary-400 hover:file:bg-primary-600/20 file:cursor-pointer transition-all">
                                                        </div>
                                                        <button type="submit"
                                                            class="w-full py-2 bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold rounded-lg transition-all cursor-pointer shadow-md">
                                                            Upload Resume
                                                        </button>
                                                    </form>
                                                </div>
                                                <% } %>
                                    </div>
                                    <% } %>

                                        <!-- Social Connections (Pointer 5 & 6) -->
                                        <div class="mt-4 pt-4 border-t border-slate-800/60">
                                            <span
                                                class="text-[11px] text-slate-500 font-bold uppercase tracking-wider block mb-3">Social
                                                Connections</span>
                                            <div class="flex flex-wrap gap-2">
                                                <% const socialsMap={}; (user.socialProfileLinks || []).forEach(s=> {
                                                    socialsMap[s.label] = s.link; });
                                                    const platforms = [
                                                    { key: 'github', icon: 'fab fa-github', color: `hover:bg-slate-800
                                                    hover:text-white border-slate-800/60 hover:border-slate-700
                                                    text-slate-450 bg-slate-950/20` },
                                                    { key: 'linkedin', icon: 'fab fa-linkedin-in', color:
                                                    `hover:bg-blue-600/20 hover:text-blue-400 border-slate-800/60
                                                    hover:border-blue-500/30 text-slate-450 bg-slate-950/20` },
                                                    { key: 'facebook', icon: 'fab fa-facebook-f', color:
                                                    `hover:bg-blue-600/20 hover:text-blue-400 border-slate-800/60
                                                    hover:border-blue-500/30 text-slate-450 bg-slate-950/20` },
                                                    { key: 'twitter', icon: 'fab fa-twitter', color:
                                                    `hover:bg-sky-500/20 hover:text-sky-400 border-slate-800/60
                                                    hover:border-sky-500/30 text-slate-450 bg-slate-950/20` },
                                                    { key: 'instagram', icon: 'fab fa-instagram', color:
                                                    `hover:bg-pink-600/20 hover:text-pink-400 border-slate-800/60
                                                    hover:border-pink-500/30 text-slate-450 bg-slate-950/20` },
                                                    { key: 'website', icon: 'fas fa-globe', color:
                                                    `hover:bg-primary-600/20 hover:text-primary-400 border-slate-800/60
                                                    hover:border-primary-500/30 text-slate-450 bg-slate-950/20` }
                                                    ];
                                                    let hasSocials = false;
                                                    platforms.forEach(p => {
                                                    if (socialsMap[p.key]) {
                                                    hasSocials = true;
                                                    %>
                                                    <a href="<%= socialsMap[p.key] %>" target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="w-9 h-9 rounded-xl border flex items-center justify-center text-sm transition-all <%= p.color %>"
                                                        title="<%= p.key.charAt(0).toUpperCase() + p.key.slice(1) %>">
                                                        <i class="<%= p.icon %>"></i>
                                                    </a>
                                                    <% } }); if (!hasSocials) { %>
                                                        <p class="text-slate-500 text-xs italic">No social links
                                                            configured yet.</p>
                                                        <% } %>
                                            </div>
                                        </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Announcements Section (col-span-7) -->
                <div class="lg:col-span-7 relative">
                    <div class="glass-card lg:absolute lg:inset-0 flex flex-col">
                        <div
                            class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-8 pb-4 border-b border-slate-850">
                            <h2 class="text-xl font-bold text-white flex items-center gap-2.5">
                                <i class="fas fa-bullhorn text-primary-500"></i> Community Announcements
                            </h2>
                            <div class="flex items-center gap-3 shrink-0">
                                <% if (user.role==='admin' ) { %>
                                    <!-- Type filter dropdown for admin -->
                                    <select onchange="window.location.href = '?announcementType=' + this.value"
                                        class="bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-350 focus:border-primary-500 focus:outline-none transition-all cursor-pointer font-medium hover:border-slate-700">
                                        <option value="" <%=!selectedType ? 'selected' : '' %>>All Types</option>
                                        <option value="community" <%=selectedType==='community' ? 'selected' : '' %>
                                            >Community</option>
                                        <option value="Resume" <%=selectedType==='Resume' ? 'selected' : '' %>>Resume
                                        </option>
                                        <option value="system update" <%=selectedType==='system update' ? 'selected'
                                            : '' %>>System Update</option>
                                    </select>
                                    <button onclick="openAnnouncementModalForCreate()"
                                        class="px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-md shadow-primary-950/20">
                                        <i class="fas fa-plus"></i> Add New
                                    </button>
                                    <% } %>
                            </div>
                        </div>

                        <% if (announcements.length> 0) { %>
                            <div class="space-y-2.5 overflow-y-auto pr-1 flex-1 h-0 lg:max-h-none max-h-[600px]">
                                <% announcements.forEach(ann=> { %>
                                    <div
                                        class="p-3 px-3.5 bg-slate-950/60 border border-slate-800/80 rounded-xl border-l-4 <%= ann.type === 'welcome' ? 'border-l-emerald-500' : ann.type === 'milestone' ? 'border-l-amber-500' : ann.type === 'Resume' ? 'border-l-indigo-500' : ann.type === 'system update' ? 'border-l-sky-500' : 'border-l-primary-500' %> flex flex-col justify-between gap-2 transition-all duration-300">
                                        <div class="flex justify-between items-start gap-4">
                                            <div class="flex items-start gap-3">
                                                <div
                                                    class="w-7 h-7 rounded-lg flex items-center justify-center bg-slate-900 border border-slate-800 text-xs shrink-0">
                                                    <i
                                                        class="fas <%= ann.type === 'welcome' ? 'fa-user-plus text-emerald-400' : ann.type === 'milestone' ? 'fa-trophy text-amber-400' : ann.type === 'Resume' ? 'fa-file-alt text-indigo-400' : ann.type === 'system update' ? 'fa-cogs text-sky-400' : 'fa-info-circle text-primary-400' %>"></i>
                                                </div>
                                                <div>
                                                    <h4
                                                        class="font-bold text-white text-sm mb-0 flex items-center gap-2 flex-wrap">
                                                        <%= ann.title %>
                                                            <% if (user.role==='admin' && !ann.isActive) { %>
                                                                <span
                                                                    class="px-1.5 py-0.2 bg-red-950/60 text-red-400 border border-red-900 rounded text-[9px] font-bold uppercase tracking-wider shrink-0">
                                                                    Inactive
                                                                </span>
                                                                <% } %>
                                                    </h4>
                                                    <div
                                                        class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[10px] text-slate-500">
                                                        <span>Posted: <%= new
                                                                Date(ann.createdAt).toLocaleDateString(undefined, {
                                                                year: 'numeric' , month: 'short' , day: 'numeric' }) %>
                                                        </span>
                                                        <span class="text-slate-650">•</span>
                                                        <span>Expires: <%= ann.endDate ? new
                                                                Date(ann.endDate).toLocaleDateString(undefined, {
                                                                year: 'numeric' , month: 'short' , day: 'numeric' })
                                                                : 'Never' %></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <% if (user.role==='admin' ) { %>
                                                <div class="flex items-center gap-2 shrink-0">
                                                    <!-- Edit Action Button -->
                                                    <button onclick="openAnnouncementModalForEdit(this)"
                                                        data-id="<%= ann.id %>" data-announcement="<%= ann.content %>"
                                                        data-isactive="<%= ann.isActive %>"
                                                        data-enddate="<%= ann.endDate ? new Date(ann.endDate).toISOString().split('T')[0] : '' %>"
                                                        data-type="<%= ann.type %>"
                                                        class="p-1.5 bg-slate-900 hover:bg-slate-800 border border-slate-850 hover:border-primary-500 text-slate-400 hover:text-white rounded transition-colors text-xs cursor-pointer"
                                                        title="Edit Announcement">
                                                        <i class="fas fa-edit"></i>
                                                    </button>

                                                    <!-- Delete Action Form -->
                                                    <form action="/dashboard/announcements/<%= ann.id %>?_method=DELETE"
                                                        method="POST"
                                                        onsubmit="return confirm('Are you sure you want to delete this announcement?');"
                                                        class="inline">
                                                        <button type="submit"
                                                            class="p-1.5 bg-slate-900 hover:bg-red-950/40 border border-slate-850 hover:border-red-500/50 text-slate-400 hover:text-red-400 rounded transition-colors text-xs cursor-pointer"
                                                            title="Delete Announcement">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                                <% } %>
                                        </div>

                                        <p
                                            class="text-slate-300 text-[13.5px] leading-relaxed whitespace-pre-line bg-slate-950/20 py-1 px-2.5 border border-slate-900/40 rounded-lg">
                                            <%= ann.content %>
                                        </p>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } else { %>
                                <div
                                    class="text-center py-16 bg-slate-950/20 border border-slate-900/60 rounded-2xl flex flex-col items-center justify-center p-6 flex-1 flex justify-center items-center">
                                    <div class="flex flex-col items-center">
                                        <div
                                            class="w-14 h-14 bg-slate-900 border border-slate-850 rounded-full flex items-center justify-center text-slate-500 text-lg mb-4">
