<section class="pt-32 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center mb-12 gap-6">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2">Welcome, <%= user.name %>!</h1>
                <p class="text-slate-400">Manage your project requests and view community updates.</p>
            </div>
            <div class="flex gap-4">
                <a href="/#contact" class="btn-primary">Book Consultation</a>
                <% if (user.role === 'admin') { %>
                    <a href="/projects/new" class="px-4 py-2 bg-slate-800 border border-slate-700 rounded-lg hover:border-primary-500 transition-all text-sm font-medium">Add Project</a>
                <% } %>
            </div>
        </div>

        <!-- Announcements -->
        <% if (announcements.length > 0) { %>
            <div class="mb-12">
                <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                    <i class="fas fa-bullhorn text-primary-500"></i> Announcements
                </h2>
                <div class="space-y-4">
                    <% announcements.forEach(ann => { %>
                        <div class="glass-card border-l-4 <%= ann.type === 'welcome' ? 'border-l-emerald-500' : 'border-l-primary-500' %> flex items-start gap-4">
                            <div class="shrink-0 mt-1">
                                <i class="fas <%= ann.type === 'welcome' ? 'fa-user-plus text-emerald-500' : 'fa-info-circle text-primary-500' %>"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-1"><%= ann.title %></h4>
                                <p class="text-slate-400 text-sm"><%= ann.content %></p>
                                <span class="text-[10px] text-slate-600 uppercase mt-2 block tracking-widest"><%= new Date(ann.createdAt).toLocaleDateString() %></span>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% } %>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left Column: Appointments & Help Requests -->
            <div class="lg:col-span-2 space-y-8">
                <!-- Appointments -->
                <div class="glass-card">
                    <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                        <i class="fas fa-calendar-check text-primary-500"></i> My Appointments
                    </h3>
                    <% if (appointments.length > 0) { %>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead>
                                    <tr class="border-b border-slate-800 text-slate-500 text-xs uppercase tracking-wider">
                                        <th class="pb-4 font-semibold">Service</th>
                                        <th class="pb-4 font-semibold">Date & Time</th>
                                        <th class="pb-4 font-semibold">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="text-sm">
                                    <% appointments.forEach(app => { %>
                                        <tr class="border-b border-slate-800/50">
                                            <td class="py-4 font-medium text-white"><%= app.service %></td>
                                            <td class="py-4 text-slate-400">
                                                <%= new Date(app.date).toLocaleDateString() %> at <%= app.time %>
                                            </td>
                                            <td class="py-4">
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider
                                                    <%= app.status === 'confirmed' ? 'bg-emerald-900/30 text-emerald-400' : 
                                                       app.status === 'pending' ? 'bg-amber-900/30 text-amber-400' : 
                                                       'bg-slate-800 text-slate-400' %>">
                                                    <%= app.status %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center py-10">
                            <p class="text-slate-500 text-sm italic">No appointments found.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Admin: Help Requests -->
                <% if (user.role === 'admin') { %>
                    <div class="glass-card">
                        <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                            <i class="fas fa-envelope-open-text text-primary-500"></i> Project Help Requests
                        </h3>
                        <% if (helpRequests.length > 0) { %>
                            <div class="space-y-4">
                                <% helpRequests.forEach(req => { %>
                                    <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg">
                                        <div class="flex justify-between items-start mb-2">
                                            <h4 class="font-bold text-white flex items-center gap-2">
                                                <%= req.name %>
                                                <span class="px-2 py-0.5 rounded text-[8px] font-bold uppercase tracking-wider bg-slate-800 text-primary-400">
                                                    <%= req.subject %>
                                                </span>
                                            </h4>
                                            <span class="text-[10px] text-slate-650"><%= new Date(req.createdAt).toLocaleDateString() %></span>
                                        </div>
                                        <p class="text-xs text-primary-400 mb-2"><%= req.email %></p>
                                        <p class="text-slate-300 text-sm italic">"<%= req.message %>"</p>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-slate-500 text-sm italic text-center py-10">No requests yet.</p>
                        <% } %>
                    </div>
                <% } else { %>
                    <!-- User: Help Requests -->
                    <div class="glass-card">
                        <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                            <i class="fas fa-question-circle text-primary-500"></i> My Help Requests
                        </h3>
                        <% if (helpRequests.length > 0) { %>
                            <div class="space-y-4">
                                <% helpRequests.forEach(req => { %>
                                    <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg">
                                        <div class="flex justify-between items-start mb-2">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-800 text-primary-450">
                                                <%= req.subject %>
                                            </span>
                                            <span class="text-[10px] text-slate-600"><%= new Date(req.createdAt).toLocaleDateString() %></span>
                                        </div>
                                        <p class="text-slate-300 text-sm my-2"><%= req.message %></p>
                                        <div class="flex justify-between items-center mt-2 pt-2 border-t border-slate-900/50">
                                            <span class="text-xs text-slate-500">Status:</span>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider
                                                <%= req.status === 'resolved' ? 'bg-emerald-900/30 text-emerald-400' : 
                                                   req.status === 'in-progress' ? 'bg-amber-900/30 text-amber-400' : 
                                                   'bg-slate-800 text-slate-400' %>">
                                                <%= req.status %>
                                            </span>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-slate-500 text-sm italic text-center py-10">No requests submitted yet.</p>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- Right Column: Profile Summary & Stats -->
            <div class="space-y-8">
                <div class="glass-card text-center">
                    <div class="w-20 h-20 bg-primary-600/20 rounded-full flex items-center justify-center mx-auto mb-6 text-primary-500 text-3xl font-bold">
                        <%= user.name.charAt(0) %>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-1"><%= user.name %></h3>
                    <% if (user.bio) { %>
                        <p class="text-slate-350 text-xs italic mb-3 px-2">"<%= user.bio %>"</p>
                    <% } %>
                    <p class="text-slate-500 text-sm mb-4"><%= user.email %></p>
                    
                    <div class="flex flex-col items-center gap-2 mb-6">
                        <div class="px-3 py-1 bg-slate-850 rounded text-[10px] font-bold uppercase text-slate-400 inline-block tracking-widest">
                            <%= user.role %> Account
                        </div>
                        <% if (user.userType && user.userType !== 'other') { %>
                            <div>
                                <span class="px-2 py-0.5 bg-primary-950/45 border border-primary-900 text-primary-400 rounded text-[9px] font-bold uppercase tracking-wider">
                                    <%= user.userType.replace('_', ' ') %>
                                </span>
                            </div>
                        <% } %>
                        <% if (user.seeking) { %>
                            <div class="text-[11px] text-slate-400 mt-1">
                                <span class="text-[10px] text-slate-500 font-semibold uppercase tracking-wider block">Interested in</span>
                                <span class="text-white text-xs"><%= user.seeking.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') %></span>
                            </div>
                        <% } %>
                        <% if (user.location) { %>
                            <div class="text-xs text-slate-400 mt-2 flex items-center gap-1 justify-center">
                                <i class="fas fa-map-marker-alt text-primary-500"></i>
                                <span><%= user.location %></span>
                            </div>
                        <% } %>
                    </div>
                    
                    <div class="mt-10 pt-8 border-t border-slate-800 grid grid-cols-2 gap-4">
                        <div>
                            <div class="text-2xl font-bold text-white"><%= appointments.length %></div>
                            <div class="text-[10px] text-slate-500 uppercase">Bookings</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-white"><%= helpRequests.length %></div>
                            <div class="text-[10px] text-slate-500 uppercase">Requests</div>
                        </div>
                    </div>
                </div>

                <% if (user.role !== 'admin') { %>
                    <div class="glass-card">
                        <h3 class="text-md font-bold text-white mb-6 flex items-center gap-2">
                            <i class="fas fa-paper-plane text-primary-500 text-sm"></i> New Help Request
                        </h3>
                        <%- include('../partials/flash') %>
                        <form action="/contact" method="POST" class="space-y-4">
                            <input type="hidden" name="name" value="<%= user.name %>">
                            <input type="hidden" name="email" value="<%= user.email %>">
                            <div>
                                <label class="block text-xs font-medium text-slate-400 mb-1">Subject</label>
                                <select name="subject" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:border-primary-500 focus:outline-none transition-colors">
                                    <option value="help">Project Help Request</option>
                                    <option value="appointment">Book an Appointment</option>
                                    <option value="other">General Inquiry</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-400 mb-1">Message</label>
                                <textarea name="message" rows="4" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:border-primary-500 focus:outline-none transition-colors" placeholder="Explain what you need help with..."></textarea>
                            </div>
                            <button type="submit" class="w-full btn-primary py-2 text-xs font-bold">Submit Request</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</section>
