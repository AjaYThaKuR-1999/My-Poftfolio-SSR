                                                    value="<%= userSocials.twitter || '' %>"
                                                    placeholder="https://twitter.com/username"
                                                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                                            </div>
                                            <div>
                                                <label
                                                    class="block text-[10px] font-semibold text-slate-450 uppercase tracking-wider mb-2">Instagram
                                                    Profile URL</label>
                                                <input type="url" name="instagram"
                                                    value="<%= userSocials.instagram || '' %>"
                                                    placeholder="https://instagram.com/username"
                                                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                                            </div>
                                            <div>
                                                <label
                                                    class="block text-[10px] font-semibold text-slate-450 uppercase tracking-wider mb-2">Facebook
                                                    Profile URL</label>
                                                <input type="url" name="facebook"
                                                    value="<%= userSocials.facebook || '' %>"
                                                    placeholder="https://facebook.com/username"
                                                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                                            </div>
                                            <div>
                                                <label
                                                    class="block text-[10px] font-semibold text-slate-450 uppercase tracking-wider mb-2">Personal
                                                    Website Link</label>
                                                <input type="url" name="website"
                                                    value="<%= userSocials.website || '' %>"
                                                    placeholder="https://yourwebsite.com"
                                                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                                            </div>
                                        </div>
                                </div>

                                <!-- Submit buttons -->
                                <div class="pt-6 border-t border-slate-850 flex justify-end gap-3 shrink-0">
                                    <button type="button" onclick="closeProfileModal()"
                                        class="px-5 py-2.5 bg-slate-950 hover:bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl text-xs text-slate-400 hover:text-white transition-all font-semibold cursor-pointer">
                                        Cancel
                                    </button>
                                    <button type="submit"
                                        class="btn-primary px-5 py-2.5 rounded-xl text-xs font-semibold cursor-pointer">
                                        Save Profile Changes
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Modal 2: Create / Edit Announcement (Admin Only) -->
                    <% if (user.role==='admin' ) { %>
                        <div id="announcementModal"
                            class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 transition-opacity duration-300">
                            <div
                                class="glass-card w-full max-w-lg bg-slate-900 border-slate-800 flex flex-col p-0 shadow-2xl relative">
                                <!-- Close button (Compact & polished in top-right absolute position) -->
                                <button onclick="closeAnnouncementModal()"
                                    class="absolute top-4 right-4 text-slate-400 hover:text-white hover:bg-slate-800/60 p-2 rounded-xl transition-all z-10 cursor-pointer text-sm">
                                    <i class="fas fa-times"></i>
                                </button>

                                <div class="p-6 border-b border-slate-850 pr-12">
                                    <h3 id="announcementModalTitle"
                                        class="text-lg font-bold text-white flex items-center gap-2">
                                        <i class="fas fa-bullhorn text-primary-500"></i> Write Community Update
                                    </h3>
                                    <p class="text-slate-400 text-xs mt-1">This notification will display to all
                                        logged-in community
                                        members.</p>
                                </div>

                                <form id="announcementForm" action="/dashboard/announcements" method="POST"
                                    class="p-6 space-y-5">
                                    <!-- Message text -->
                                    <div>
                                        <label
                                            class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Announcement
                                            Body Text</label>
                                        <textarea id="announcementText" name="announcement" rows="4" required
                                            placeholder="Type the update text message here..."
                                            class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium"></textarea>
                                    </div>

                                    <!-- Announcement Type -->
                                    <div>
                                        <label
                                            class="block text-xs font-semibold text-slate-455 uppercase tracking-wider mb-2">Announcement
                                            Type</label>
                                        <select id="announcementType" name="type"
                                            class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium cursor-pointer">
                                            <option value="community">Community</option>
                                            <option value="Resume">Resume</option>
                                            <option value="system update">System Update</option>
                                        </select>
                                    </div>

                                    <!-- Expire Date -->
                                    <div>
                                        <label
                                            class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Expiration
                                            Date (Optional)</label>
                                        <input type="date" id="announcementEndDate" name="endDate"
                                            class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                                        <span class="text-[10px] text-slate-500 block mt-1.5">If left empty, defaults to
                                            7 days from
                                            creation.</span>
                                    </div>

                                    <!-- Active status -->
                                    <div id="activeCheckboxContainer"
                                        class="flex items-center gap-3 bg-slate-950/50 p-3 border border-slate-850 rounded-xl">
                                        <input type="checkbox" id="announcementIsActive" name="isActive" value="true"
                                            checked
                                            class="w-4 h-4 text-primary-600 bg-slate-950 border-slate-800 rounded focus:ring-primary-500 focus:ring-2 focus:ring-offset-slate-900 cursor-pointer">
                                        <label for="announcementIsActive"
                                            class="text-xs font-semibold text-slate-350 select-none cursor-pointer">Is
                                            Active & Visible
                                            Immediately</label>
                                    </div>

                                    <!-- Actions -->
                                    <div class="pt-4 border-t border-slate-850 flex justify-end gap-3">
                                        <button type="button" onclick="closeAnnouncementModal()"
                                            class="px-4 py-2 bg-slate-950 hover:bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl text-xs text-slate-400 hover:text-white transition-all font-semibold cursor-pointer">
                                            Cancel
                                        </button>
                                        <button type="submit" id="announcementSubmitButton"
                                            class="btn-primary px-4 py-2 rounded-xl text-xs font-semibold cursor-pointer">
                                            Post Announcement
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <% } %>


                            <!-- ===========================================================================
     SCRIPTS & EVENT LISTENERS
     =========================================================================== -->
                            <script>
                                // ─────────────────────────────────────────────────────────────────────────
                                // Edit Profile Modal
                                // ─────────────────────────────────────────────────────────────────────────
                                const profileModal = document.getElementById('profileModal');

                                function openProfileModal() {
                                    if (!profileModal) return;
                                    profileModal.classList.remove('hidden');
                                    document.body.classList.add('overflow-hidden');
                                }

                                function closeProfileModal() {
                                    if (!profileModal) return;
                                    profileModal.classList.add('hidden');
                                    document.body.classList.remove('overflow-hidden');
                                }

                                // ─────────────────────────────────────────────────────────────────────────
                                // Interactive Messaging Console
                                // ─────────────────────────────────────────────────────────────────────────
                                const intentStyles = {
                                    general: {
                                        inactive: 'intent-btn group/btn px-1 py-1.5 sm:px-2.5 sm:py-2 rounded-lg border transition-all cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 duration-300 border-slate-800 bg-slate-950/40 text-slate-400 hover:border-cyan-500/50 hover:bg-cyan-950/20 hover:text-cyan-300',
                                        active: 'intent-btn group/btn px-1 py-1.5 sm:px-2.5 sm:py-2 rounded-lg border transition-all cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 duration-300 border-cyan-500 bg-cyan-500/10 text-cyan-400 shadow-[0_0_12px_rgba(6,182,212,0.15)]'
                                    },
                                    hiring: {
                                        inactive: 'intent-btn group/btn px-1 py-1.5 sm:px-2.5 sm:py-2 rounded-lg border transition-all cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 duration-300 border-slate-800 bg-slate-950/40 text-slate-400 hover:border-emerald-500/50 hover:bg-emerald-950/20 hover:text-emerald-300',
                                        active: 'intent-btn group/btn px-1 py-1.5 sm:px-2.5 sm:py-2 rounded-lg border transition-all cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 duration-300 border-emerald-500 bg-emerald-500/10 text-emerald-400 shadow-[0_0_12px_rgba(16,185,129,0.15)]'
                                    },
                                    collab: {
                                        inactive: 'intent-btn group/btn px-1 py-1.5 sm:px-2.5 sm:py-2 rounded-lg border transition-all cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 duration-300 border-slate-800 bg-slate-950/40 text-slate-400 hover:border-indigo-500/50 hover:bg-indigo-950/20 hover:text-indigo-300',
                                        active: 'intent-btn group/btn px-1.5 py-1.5 sm:px-2.5 sm:py-2 rounded-lg border transition-all cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 duration-300 border-indigo-500 bg-indigo-500/10 text-indigo-400 shadow-[0_0_12px_rgba(99,102,241,0.15)]'
                                    },
                                    support: {
                                        inactive: 'intent-btn group/btn px-1 py-1.5 sm:px-2.5 sm:py-2 rounded-lg border transition-all cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 duration-300 border-slate-800 bg-slate-950/40 text-slate-400 hover:border-amber-500/50 hover:bg-amber-950/20 hover:text-amber-300',
                                        active: 'intent-btn group/btn px-1 py-1.5 sm:px-2.5 sm:py-2 rounded-lg border transition-all cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 duration-300 border-amber-500 bg-amber-500/10 text-amber-400 shadow-[0_0_12px_rgba(245,158,11,0.15)]'
                                    },
                                    feedback: {
                                        inactive: 'intent-btn group/btn px-1 py-1.5 sm:px-2.5 sm:py-2 rounded-lg border transition-all cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 duration-300 border-slate-800 bg-slate-950/40 text-slate-400 hover:border-pink-500/50 hover:bg-pink-950/20 hover:text-pink-300',
                                        active: 'intent-btn group/btn px-1.5 py-1.5 sm:px-2.5 sm:py-2 rounded-lg border transition-all cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 duration-300 border-pink-500 bg-pink-500/10 text-pink-400 shadow-[0_0_12px_rgba(236,72,153,0.15)]'
                                    }
                                };

                                const dotBgClasses = {
                                    general: 'bg-cyan-400 shadow-[0_0_8px_#22d3ee]',
                                    hiring: 'bg-emerald-400 shadow-[0_0_8px_#34d399]',
                                    collab: 'bg-indigo-400 shadow-[0_0_8px_#818cf8]',
                                    support: 'bg-amber-400 shadow-[0_0_8px_#fbbf24]',
                                    feedback: 'bg-pink-400 shadow-[0_0_8px_#f472b6]'
                                };

                                const ledActiveClasses = {
                                    general: 'bg-cyan-400 shadow-[0_0_6px_#22d3ee]',
                                    hiring: 'bg-emerald-400 shadow-[0_0_6px_#34d399]',
                                    collab: 'bg-indigo-400 shadow-[0_0_6px_#818cf8]',
                                    support: 'bg-amber-400 shadow-[0_0_6px_#fbbf24]',
                                    feedback: 'bg-pink-400 shadow-[0_0_6px_#f472b6]'
                                };

                                const intentSubjects = {
                                    general: 'General',
                                    hiring: 'Hiring Inquiry',
                                    collab: 'Collaboration Proposal',
                                    support: 'Help / Support Request',
                                    feedback: 'Feedback / Review'
                                };

                                const intentDescriptions = {
                                    general: 'Direct chat channel for general inquiries, casual networking, and greeting the admin.',
                                    hiring: 'Secure route for job openings, contract opportunities, full-time roles, or recruiting discussions.',
                                    collab: 'Open channel to pitch projects, request code review, or propose open-source collaborations.',
                                    support: 'Assistance channel for website issues, bug reports, and project deployment help.',
                                    feedback: 'A space to leave reviews, portfolio feedback, testimonials, or recommendations.'
                                };

                                let selectedIntentType = null;

                                function toggleIntentCurtain() {
                                    const container = document.getElementById('intent-grid-container');
                                    const icon = document.getElementById('intent-toggle-icon');
                                    const toggleBtnText = document.querySelector('#intent-toggle-btn span');
                                    const pill = document.getElementById('selected-intent-pill');
                                    const descText = document.getElementById('intent-desc-text');
                                    const cursor = document.getElementById('intent-console-cursor');
                                    
                                    if (container) {
                                        if (container.classList.contains('max-h-0')) {
                                            // Curtain Up (reveal grid)
                                            container.classList.remove('max-h-0', 'opacity-0', 'mb-0');
                                            container.classList.add('max-h-[150px]', 'opacity-100', 'mb-2');
                                            if (icon) icon.className = 'fas fa-chevron-down text-[8px]';
                                            if (toggleBtnText) toggleBtnText.textContent = 'Curtain Down';
                                            if (pill) pill.classList.add('hidden');
                                            if (descText) descText.classList.remove('hidden');
                                            if (cursor) cursor.classList.remove('hidden');
                                        } else {
                                            // Curtain Down (hide grid)
                                            container.classList.remove('max-h-[150px]', 'opacity-100', 'mb-2');
                                            container.classList.add('max-h-0', 'opacity-0', 'mb-0');
                                            if (icon) icon.className = 'fas fa-chevron-up text-[8px]';
                                            if (toggleBtnText) toggleBtnText.textContent = 'Curtain Up';
                                            if (selectedIntentType) {
                                                if (pill) pill.classList.remove('hidden');
                                                if (descText) descText.classList.add('hidden');
                                                if (cursor) cursor.classList.add('hidden');
                                            }
                                        }
                                    }
                                }

                                function hoverIntent(type) {
                                    const dot = document.getElementById('intent-desc-dot');
                                    const text = document.getElementById('intent-desc-text');
                                    if (dot && text) {
                                        dot.className = `w-1.5 h-1.5 rounded-full shrink-0 transition-all duration-300 ${dotBgClasses[type]}`;
                                        text.innerHTML = `<span class="font-extrabold uppercase tracking-wider">[ROUTING: ${intentSubjects[type] === 'General Inquiry' ? 'General' : intentSubjects[type]}]</span> ${intentDescriptions[type]}`;
                                        if (type === 'general') text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-cyan-400';
                                        else if (type === 'hiring') text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-emerald-400';
                                        else if (type === 'collab') text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-indigo-400';
                                        else if (type === 'support') text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-amber-400';
                                        else if (type === 'feedback') text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-pink-400';
                                    }

                                    // Preview indicator LED inside the hovered button
                                    const led = document.getElementById(`intent-led-${type}`);
                                    if (led) {
                                        led.className = `intent-led w-1 h-1 sm:w-1.5 sm:h-1.5 rounded-full transition-all duration-300 shrink-0 ${ledActiveClasses[type]}`;
                                    }
                                }

                                function unhoverIntent() {
                                    const dot = document.getElementById('intent-desc-dot');
                                    const text = document.getElementById('intent-desc-text');
                                    const container = document.getElementById('intent-grid-container');
                                    const pill = document.getElementById('selected-intent-pill');
                                    const cursor = document.getElementById('intent-console-cursor');

                                    const isCollapsed = container ? container.classList.contains('max-h-0') : true;

                                    if (dot && text) {
                                        if (selectedIntentType) {
                                            if (isCollapsed) {
                                                // If collapsed, hide descriptions completely and only show the pill
                                                dot.className = 'hidden';
                                                text.className = 'hidden';
                                                if (cursor) cursor.classList.add('hidden');
                                                if (pill) pill.classList.remove('hidden');
                                            } else {
                                                // If curtain is up (grid open), show the active selection details
                                                const type = selectedIntentType;
                                                dot.className = `w-1.5 h-1.5 rounded-full shrink-0 transition-all duration-300 ${dotBgClasses[type]}`;
                                                text.innerHTML = `<span class="font-extrabold uppercase tracking-wider">[SELECTED: ${intentSubjects[type] === 'General Inquiry' ? 'General' : intentSubjects[type]}]</span> ${intentDescriptions[type]}`;
                                                if (type === 'general') text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-cyan-400';
                                                else if (type === 'hiring') text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-emerald-400';
                                                else if (type === 'collab') text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-indigo-400';
                                                else if (type === 'support') text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-amber-400';
                                                else if (type === 'feedback') text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-pink-400';
                                                if (cursor) cursor.classList.remove('hidden');
                                                if (pill) pill.classList.add('hidden');
                                            }
                                        } else {
                                            dot.className = 'w-1.5 h-1.5 rounded-full bg-slate-700 shrink-0 transition-all duration-300';
                                            text.textContent = 'Select route to unlock secure console terminal...';
                                            text.className = 'whitespace-normal break-words leading-relaxed block flex-1 text-slate-400';
                                            if (cursor) cursor.classList.remove('hidden');
                                            if (pill) pill.classList.add('hidden');
                                        }
                                    }

                                    // Reset all LEDs to inactive state except for the selected one
                                    Object.keys(intentStyles).forEach(t => {
                                        const ledEl = document.getElementById(`intent-led-${t}`);
                                        if (ledEl) {
                                            if (selectedIntentType === t) {
                                                ledEl.className = `intent-led w-1 h-1 sm:w-1.5 sm:h-1.5 rounded-full transition-all duration-300 shrink-0 ${ledActiveClasses[t]}`;
                                            } else {
                                                ledEl.className = 'intent-led w-1 h-1 sm:w-1.5 sm:h-1.5 rounded-full bg-slate-700 transition-all duration-300 shrink-0';
                                            }
                                        }
                                    });
                                }

                                function selectIntent(btn, subjectValue, placeholderText, type) {
                                    selectedIntentType = type;

                                    // Update hidden subject field
                                    const subjectInput = document.getElementById('console-subject');
                                    if (subjectInput) {
                                        subjectInput.value = subjectValue === 'General Inquiry' ? 'General' : subjectValue;
                                    }

                                    // Unlock textarea and send button
                                    const textarea = document.getElementById('console-message');
                                    const sendBtn = document.getElementById('console-send-btn');

                                    if (textarea) {
                                        textarea.disabled = false;
                                        textarea.placeholder = placeholderText;
                                        textarea.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-slate-950/50');
                                        textarea.focus();
                                    }

                                    if (sendBtn) {
                                        sendBtn.disabled = false;
                                        sendBtn.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                                    }

                                    // Reset all button styles to inactive state
                                    Object.keys(intentStyles).forEach(t => {
                                        const btnEl = document.getElementById(`intent-btn-${t}`);
                                        if (btnEl) {
                                            btnEl.className = intentStyles[t].inactive;
                                        }
                                    });

                                    // Apply active styles to clicked button
                                    const activeStyle = intentStyles[type] ? intentStyles[type].active : '';
                                    btn.className = activeStyle;

                                    // Update selected route pill
                                    const pill = document.getElementById('selected-intent-pill');
                                    if (pill) {
                                        let emoji = '💬';
                                        let pillColorClass = '';
                                        if (type === 'general') { emoji = '💬'; pillColorClass = 'text-cyan-400 bg-cyan-950/30 border-cyan-800/50'; }
                                        else if (type === 'hiring') { emoji = '💼'; pillColorClass = 'text-emerald-400 bg-emerald-950/30 border-emerald-800/50'; }
                                        else if (type === 'collab') { emoji = '🤝'; pillColorClass = 'text-indigo-400 bg-indigo-950/30 border-indigo-800/50'; }
                                        else if (type === 'support') { emoji = '🛠️'; pillColorClass = 'text-amber-400 bg-amber-950/30 border-amber-800/50'; }
                                        else if (type === 'feedback') { emoji = '💡'; pillColorClass = 'text-pink-400 bg-pink-950/30 border-pink-800/50'; }
                                        
                                        pill.innerHTML = `${emoji} ${intentSubjects[type] === 'General Inquiry' ? 'General' : intentSubjects[type]}`;
                                        pill.className = `px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider ${pillColorClass}`;
                                        pill.classList.remove('hidden');
                                    }

                                    // Hide description text and cursor when collapsed
                                    const descText = document.getElementById('intent-desc-text');
                                    if (descText) descText.classList.add('hidden');
                                    const cursor = document.getElementById('intent-console-cursor');
                                    if (cursor) cursor.classList.add('hidden');

                                    // Auto collapse the intent grid container (curtain down)
                                    const container = document.getElementById('intent-grid-container');
                                    if (container) {
                                        container.classList.remove('max-h-[150px]', 'opacity-100', 'mb-2');
                                        container.classList.add('max-h-0', 'opacity-0', 'mb-0');
                                    }
                                    const icon = document.getElementById('intent-toggle-icon');
                                    if (icon) {
                                        icon.className = 'fas fa-chevron-up text-[8px]';
                                    }
                                    const toggleBtnText = document.querySelector('#intent-toggle-btn span');
                                    if (toggleBtnText) {
                                        toggleBtnText.textContent = 'Curtain Up';
                                    }
                                    const toggleBtn = document.getElementById('intent-toggle-btn');
                                    if (toggleBtn) {
                                        toggleBtn.classList.remove('hidden');
                                    }

                                    // Trigger update of status text and LEDs
                                    unhoverIntent();
                                }

                                // ─────────────────────────────────────────────────────────────────────────
                                // Announcement CRUD Modal (Admin Only)
                                // ─────────────────────────────────────────────────────────────────────────
                                const announcementModal = document.getElementById('announcementModal');
                                const announcementForm = document.getElementById('announcementForm');
                                const announcementModalTitle = document.getElementById('announcementModalTitle');
                                const announcementText = document.getElementById('announcementText');
                                const announcementEndDate = document.getElementById('announcementEndDate');
                                const announcementIsActive = document.getElementById('announcementIsActive');
                                const activeCheckboxContainer = document.getElementById('activeCheckboxContainer');
                                const announcementSubmitButton = document.getElementById('announcementSubmitButton');

                                function openAnnouncementModalForCreate() {
                                    if (!announcementModal) return;

                                    // Reset form to Create Mode
                                    announcementForm.action = "/dashboard/announcements";
                                    announcementModalTitle.innerHTML = '<i class="fas fa-bullhorn text-primary-500"></i> Write Community Update';
                                    announcementText.value = '';
                                    announcementEndDate.value = '';
                                    const announcementTypeField = document.getElementById('announcementType');
                                    if (announcementTypeField) announcementTypeField.value = 'community';
                                    if (announcementIsActive) announcementIsActive.checked = true;
                                    if (activeCheckboxContainer) activeCheckboxContainer.classList.remove('hidden');
                                    announcementSubmitButton.textContent = 'Post Announcement';

                                    announcementModal.classList.remove('hidden');
                                    document.body.classList.add('overflow-hidden');
                                }

                                function openAnnouncementModalForEdit(btn) {
                                    if (!announcementModal) return;

                                    const id = btn.getAttribute('data-id');
                                    const announcement = btn.getAttribute('data-announcement');
                                    const isActive = btn.getAttribute('data-isactive') === 'true';
                                    const endDate = btn.getAttribute('data-enddate');
                                    const type = btn.getAttribute('data-type') || 'community';

                                    // Configure form for Update Mode
                                    announcementForm.action = `/dashboard/announcements/${id}?_method=PUT`;
                                    announcementModalTitle.innerHTML = '<i class="fas fa-edit text-primary-500"></i> Edit Community Announcement';
                                    announcementText.value = announcement;
                                    announcementEndDate.value = endDate || '';
                                    const announcementTypeField = document.getElementById('announcementType');
                                    if (announcementTypeField) announcementTypeField.value = type;
                                    if (announcementIsActive) announcementIsActive.checked = isActive;
                                    if (activeCheckboxContainer) activeCheckboxContainer.classList.add('hidden');
                                    announcementSubmitButton.textContent = 'Save Changes';

                                    announcementModal.classList.remove('hidden');
                                    document.body.classList.add('overflow-hidden');
                                }

                                function closeAnnouncementModal() {
                                    if (!announcementModal) return;
                                    announcementModal.classList.add('hidden');
                                    document.body.classList.remove('overflow-hidden');
                                }

                                // Close Modals on Outer Backdrop Click
                                window.addEventListener('click', (e) => {
                                    if (e.target === profileModal) closeProfileModal();
                                    if (e.target === announcementModal) closeAnnouncementModal();
                                });
                            </script>
