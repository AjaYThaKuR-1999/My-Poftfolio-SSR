<section class="pt-32 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Welcome Header & Action Buttons -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-12 gap-6 border-b border-slate-800/80 pb-8 animate-fade-in">
            <div>
                <h1 class="text-4xl font-extrabold text-white mb-2 tracking-tight">Welcome back, <%= user.name %>!</h1>
                <p class="text-slate-400">Access your dashboard profile details and stay up to date with the latest community announcements.</p>
            </div>
            <div class="flex gap-4 shrink-0">
                <% if (user.role === 'admin') { %>
                    <a href="/users" class="px-5 py-3 bg-slate-800 border border-slate-700 hover:border-primary-500 hover:text-white rounded-xl text-slate-300 transition-all text-sm font-semibold flex items-center gap-2">
                        <i class="fas fa-users"></i> View Users
                    </a>
                <% } %>
                <a href="/projects" class="btn-primary px-5 py-3 rounded-xl text-sm font-semibold flex items-center gap-2">
                    <i class="fas fa-project-diagram"></i> View Projects
                </a>
            </div>
        </div>

        <%- include('../partials/flash') %>

        <!-- Rebalanced 2-Column Section: Profile details vs. Announcements -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
            <!-- Left Column: Profile Card & Quick Actions (col-span-5) -->
            <div class="lg:col-span-5 flex flex-col gap-8">
                <!-- Profile Card -->
                <div class="glass-card overflow-hidden flex flex-col justify-between">
                    <div>
                        <!-- Cover Background with Gradient -->
                        <div class="h-28 bg-gradient-to-r from-primary-900/30 to-slate-900/40 border-b border-slate-800/60 -mx-6 -mt-6 mb-12 relative shrink-0">
                            <div class="absolute -bottom-8 left-6">
                                <div class="relative">
                                    <% if (user.profilePicture) { %>
                                        <img src="<%= user.profilePicture %>" alt="<%= user.name %>" class="w-20 h-20 rounded-2xl border-4 border-slate-950 object-cover shadow-xl bg-slate-900">
                                    <% } else { %>
                                        <div class="w-20 h-20 rounded-2xl border-4 border-slate-950 bg-gradient-to-br from-primary-660 to-indigo-700 flex items-center justify-center text-white text-2xl font-black shadow-xl">
                                            <%= user.name.charAt(0).toUpperCase() %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Name and Bio -->
                        <div class="mb-6">
                            <h3 class="text-2xl font-bold text-white mb-1"><%= user.name %></h3>
                            <span class="px-2.5 py-0.5 bg-primary-950/45 border border-primary-900 text-primary-400 rounded-md text-[10px] font-bold uppercase tracking-wider inline-block">
                                <%= user.role.toUpperCase() %> ACCOUNT
                            </span>
                            
                            <% if (user.bio) { %>
                                <div class="mt-4 p-3.5 bg-slate-950/40 border border-slate-800/80 rounded-xl">
                                    <p class="text-slate-350 text-xs italic leading-relaxed">"<%= user.bio %>"</p>
                                </div>
                            <% } %>
                        </div>

                        <!-- Detailed Grid of Information (Stacked to avoid wrapping overflows) -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-4 py-4 border-t border-slate-850">
                            <div>
                                <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Email Address</span>
                                <span class="text-white text-xs block break-all font-medium"><%= user.email %></span>
                            </div>
                            <div>
                                <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Location</span>
                                <span class="text-slate-300 text-xs block font-medium">
                                    <i class="fas fa-map-marker-alt text-primary-500 mr-1"></i><%= user.location || 'Not Specified' %>
                                </span>
                            </div>
                            <div>
                                <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">User Role Type</span>
                                <span class="text-slate-300 text-xs block font-medium">
                                    <%= user.userType ? user.userType.charAt(0).toUpperCase() + user.userType.slice(1).replace('_', ' ') : 'Not Specified' %>
                                </span>
                            </div>
                            <div>
                                <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Seeking Preference</span>
                                <span class="text-slate-300 text-xs block font-medium">
                                    <%= user.seeking ? user.seeking.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') : 'Not Specified' %>
                                </span>
                            </div>
                            <div class="sm:col-span-2 lg:col-span-1 xl:col-span-2">
                                <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Member Since</span>
                                <span class="text-slate-400 text-xs block font-medium">
                                    <%= new Date(user.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                </span>
                            </div>
                        </div>

                        <!-- Social Profile Links -->
                        <div class="mt-6 pt-4 border-t border-slate-850">
                            <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-3">Social Connections</span>
                            <div class="flex flex-wrap gap-2.5">
                                <% 
                                    const socialsMap = {};
                                    (user.socialProfileLinks || []).forEach(s => { socialsMap[s.label] = s.link; });
                                    const platforms = [
                                        { key: 'github', icon: 'fab fa-github', color: 'hover:bg-slate-800 hover:text-white border-slate-700/80 text-slate-400' },
                                        { key: 'linkedin', icon: 'fab fa-linkedin-in', color: 'hover:bg-blue-600/20 hover:text-blue-400 border-slate-700/80 text-slate-400' },
                                        { key: 'facebook', icon: 'fab fa-facebook-f', color: 'hover:bg-blue-600/20 hover:text-blue-400 border-slate-700/80 text-slate-400' },
                                        { key: 'twitter', icon: 'fab fa-twitter', color: 'hover:bg-sky-500/20 hover:text-sky-400 border-slate-700/80 text-slate-400' },
                                        { key: 'instagram', icon: 'fab fa-instagram', color: 'hover:bg-pink-600/20 hover:text-pink-400 border-slate-700/80 text-slate-400' },
                                        { key: 'website', icon: 'fas fa-globe', color: 'hover:bg-primary-600/20 hover:text-primary-400 border-slate-700/80 text-slate-400' }
                                    ];
                                    let hasSocials = false;
                                    platforms.forEach(p => {
                                        if (socialsMap[p.key]) {
                                            hasSocials = true;
                                %>
                                            <a href="<%= socialsMap[p.key] %>" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg border flex items-center justify-center text-sm transition-all <%= p.color %>" title="<%= p.key.charAt(0).toUpperCase() + p.key.slice(1) %>">
                                                <i class="<%= p.icon %>"></i>
                                            </a>
                                <% 
                                        }
                                    });
                                    if (!hasSocials) { 
                                %>
                                    <p class="text-slate-500 text-xs italic">No social links configured yet.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 pt-6 border-t border-slate-850 bg-slate-950/10 -mx-6 -mb-6 p-6">
                        <!-- Edit Profile Details Button (For all users) -->
                        <button onclick="openProfileModal()" class="w-full py-2.5 bg-slate-900 border border-slate-800 hover:border-primary-500 hover:text-white rounded-xl text-slate-350 font-semibold transition-all text-xs flex items-center justify-center gap-2 cursor-pointer shadow-md <%= user.role === 'admin' ? 'mb-4' : '' %>">
                            <i class="fas fa-user-edit text-primary-500"></i> Edit Profile Details
                        </button>

                        <% if (user.role === 'admin') { %>
                            <!-- Resume Section for Admin -->
                            <div class="border-t border-slate-800/60 pt-4 mt-4">
                                <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block mb-2">My Professional Resume</span>
                                <% if (user.resume) { %>
                                    <div class="space-y-3">
                                        <!-- Download current resume button -->
                                        <a href="/dashboard/resume/download" class="w-full py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md shadow-primary-950/20">
                                            <i class="fas fa-file-download"></i> Download Resume
                                        </a>

                                        <!-- Collapsible Update Option -->
                                        <details class="group border border-slate-800 rounded-xl bg-slate-950/30 overflow-hidden">
                                            <summary class="list-none flex justify-between items-center px-4 py-2.5 text-xs text-slate-400 font-semibold cursor-pointer hover:bg-slate-900/50 hover:text-white select-none transition-all">
                                                <span>Update Resume File</span>
                                                <i class="fas fa-chevron-down text-[10px] transform group-open:rotate-180 transition-transform"></i>
                                            </summary>
                                            <div class="p-4 border-t border-slate-850/40 bg-slate-950/40">
                                                <form action="/dashboard/resume" method="POST" enctype="multipart/form-data" class="space-y-3">
                                                    <div>
                                                        <label class="block text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Select File (PDF, DOC, DOCX - Max 10MB)</label>
                                                        <input type="file" name="resume" accept=".pdf,.doc,.docx" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-slate-400 file:mr-3 file:py-1 file:px-2.5 file:rounded file:border-0 file:text-[9px] file:font-bold file:bg-primary-600/10 file:text-primary-400 hover:file:bg-primary-600/20 file:cursor-pointer transition-all">
                                                    </div>
                                                    <button type="submit" class="w-full py-2 bg-slate-900 border border-slate-800 hover:border-primary-500 hover:text-white text-xs font-semibold rounded-lg transition-all cursor-pointer">
                                                        Upload & Replace
                                                    </button>
                                                </form>
                                            </div>
                                        </details>
                                    </div>
                                <% } else { %>
                                    <!-- No Resume Uploaded: Upload Form directly -->
                                    <div class="p-4 border border-slate-800 rounded-xl bg-slate-950/30">
                                        <form action="/dashboard/resume" method="POST" enctype="multipart/form-data" class="space-y-3">
                                            <div>
                                                <label class="block text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Upload Resume (PDF, DOC, DOCX - Max 10MB)</label>
                                                <input type="file" name="resume" accept=".pdf,.doc,.docx" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-slate-400 file:mr-3 file:py-1 file:px-2.5 file:rounded file:border-0 file:text-[9px] file:font-bold file:bg-primary-600/10 file:text-primary-400 hover:file:bg-primary-600/20 file:cursor-pointer transition-all">
                                            </div>
                                            <button type="submit" class="w-full py-2 bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold rounded-lg transition-all cursor-pointer shadow-md">
                                                Upload Resume
                                            </button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <% if (user.role !== 'admin') { %>
                    <!-- Quick Actions Card (Non-Admin Only) -->
                    <div class="glass-card">
                        <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                            <i class="fas fa-bolt text-primary-500"></i> Quick Actions
                        </h3>
                        <div class="space-y-3">
                            <!-- Download Owner's Resume -->
                            <% if (adminResume) { %>
                                <a href="/dashboard/resume/download" class="w-full py-2.5 bg-slate-900 border border-slate-850 hover:border-primary-500 hover:text-white rounded-xl text-slate-300 font-semibold transition-all text-xs flex items-center justify-center gap-2 cursor-pointer shadow-md">
                                    <i class="fas fa-file-download text-primary-500"></i> Download Owner's Resume
                                </a>
                            <% } else { %>
                                <div class="w-full py-2.5 bg-slate-950/40 border border-slate-900/60 rounded-xl text-slate-500 text-xs flex items-center justify-center gap-2 select-none">
                                    <i class="fas fa-file-excel"></i> Owner Resume Not Available
                                </div>
                            <% } %>

                            <!-- Send Feedback to Admin (Disabled Placeholder) -->
                            <button disabled class="w-full py-2.5 bg-slate-950/20 border border-slate-900/60 text-slate-500 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 cursor-not-allowed opacity-60">
                                <i class="fas fa-comment-dots"></i> Send Feedback (Coming Soon)
                            </button>

                            <!-- Ask for Help Request (Disabled Placeholder) -->
                            <button disabled class="w-full py-2.5 bg-slate-950/20 border border-slate-900/60 text-slate-500 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 cursor-not-allowed opacity-60">
                                <i class="fas fa-question-circle"></i> Request Assistance (Coming Soon)
                            </button>
                        </div>
                    </div>
                <% } %>
            </div>



            <!-- Right Column: Announcements Section (col-span-7) -->
            <div class="lg:col-span-7">
                <div class="glass-card h-full flex flex-col">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-8 pb-4 border-b border-slate-850">
                        <h2 class="text-xl font-bold text-white flex items-center gap-2.5">
                            <i class="fas fa-bullhorn text-primary-500"></i> Community Announcements
                        </h2>
                        <div class="flex items-center gap-3 shrink-0">
                            <% if (user.role === 'admin') { %>
                                <!-- Type filter dropdown for admin -->
                                <select onchange="window.location.href = '?announcementType=' + this.value" class="bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-350 focus:border-primary-500 focus:outline-none transition-all cursor-pointer font-medium hover:border-slate-700">
                                    <option value="" <%= !selectedType ? 'selected' : '' %>>All Types</option>
                                    <option value="community" <%= selectedType === 'community' ? 'selected' : '' %>>Community</option>
                                    <option value="Resume" <%= selectedType === 'Resume' ? 'selected' : '' %>>Resume</option>
                                    <option value="system update" <%= selectedType === 'system update' ? 'selected' : '' %>>System Update</option>
                                </select>
                                <button onclick="openAnnouncementModalForCreate()" class="px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-md shadow-primary-950/20">
                                    <i class="fas fa-plus"></i> Add New
                                </button>
                            <% } %>
                        </div>
                    </div>

                    <% if (announcements.length > 0) { %>
                        <div class="space-y-4 overflow-y-auto pr-1 flex-1 max-h-[640px]">
                            <% announcements.forEach(ann => { %>
                                <div class="p-5 bg-slate-950/60 border border-slate-800/80 rounded-xl border-l-4 <%= ann.type === 'welcome' ? 'border-l-emerald-500' : ann.type === 'milestone' ? 'border-l-amber-500' : ann.type === 'Resume' ? 'border-l-indigo-500' : ann.type === 'system update' ? 'border-l-sky-500' : 'border-l-primary-500' %> flex flex-col justify-between gap-3 transition-all duration-300">
                                    <div class="flex justify-between items-start gap-4">
                                        <div class="flex items-start gap-3">
                                            <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-slate-900 border border-slate-800 text-sm shrink-0">
                                                <i class="fas <%= ann.type === 'welcome' ? 'fa-user-plus text-emerald-400' : ann.type === 'milestone' ? 'fa-trophy text-amber-400' : ann.type === 'Resume' ? 'fa-file-alt text-indigo-400' : ann.type === 'system update' ? 'fa-cogs text-sky-400' : 'fa-info-circle text-primary-400' %>"></i>
                                            </div>
                                            <div>
                                                <h4 class="font-bold text-white text-sm mb-0.5 flex items-center gap-2 flex-wrap">
                                                    <%= ann.title %>
                                                    <% if (user.role === 'admin' && !ann.isActive) { %>
                                                        <span class="px-1.5 py-0.2 bg-red-950/60 text-red-400 border border-red-900 rounded text-[9px] font-bold uppercase tracking-wider shrink-0">
                                                            Inactive
                                                        </span>
                                                    <% } %>
                                                </h4>
                                                <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[10px] text-slate-500">
                                                    <span>Posted: <%= new Date(ann.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                                                    <span class="text-slate-650">•</span>
                                                    <span>Expires: <%= ann.endDate ? new Date(ann.endDate).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Never' %></span>
                                                </div>
                                            </div>
                                        </div>

                                        <% if (user.role === 'admin') { %>
                                            <div class="flex items-center gap-2 shrink-0">
                                                <!-- Edit Action Button -->
                                                <button onclick="openAnnouncementModalForEdit(this)"
                                                    data-id="<%= ann.id %>"
                                                    data-announcement="<%= ann.content %>"
                                                    data-isactive="<%= ann.isActive %>"
                                                    data-enddate="<%= ann.endDate ? new Date(ann.endDate).toISOString().split('T')[0] : '' %>"
                                                    data-type="<%= ann.type %>"
                                                    class="p-1.5 bg-slate-900 hover:bg-slate-800 border border-slate-850 hover:border-primary-500 text-slate-400 hover:text-white rounded transition-colors text-xs cursor-pointer"
                                                    title="Edit Announcement">
                                                    <i class="fas fa-edit"></i>
                                                </button>

                                                <!-- Delete Action Form -->
                                                <form action="/dashboard/announcements/<%= ann.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this announcement?');" class="inline">
                                                    <button type="submit" class="p-1.5 bg-slate-900 hover:bg-red-950/40 border border-slate-850 hover:border-red-500/50 text-slate-400 hover:text-red-400 rounded transition-colors text-xs cursor-pointer" title="Delete Announcement">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        <% } %>
                                    </div>
                                    
                                    <p class="text-slate-300 text-xs leading-relaxed whitespace-pre-line bg-slate-950/20 p-2 border border-slate-900/40 rounded-lg"><%= ann.content %></p>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-16 bg-slate-950/20 border border-slate-900/60 rounded-2xl flex flex-col items-center justify-center p-6 flex-1 flex justify-center items-center">
                            <div class="flex flex-col items-center">
                                <div class="w-14 h-14 bg-slate-900 border border-slate-850 rounded-full flex items-center justify-center text-slate-500 text-lg mb-4">
                                    <i class="fas fa-bullhorn"></i>
                                </div>
                                <h4 class="text-white font-bold text-sm mb-1">No Announcements Yet</h4>
                                <p class="text-slate-500 text-xs max-w-xs leading-relaxed">Check back later for important system news and community highlights.</p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===========================================================================
     MODALS DIALOG MARKUP
     =========================================================================== -->

<!-- Modal 1: Edit Profile -->
<div id="profileModal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 transition-opacity duration-300">
    <div class="glass-card w-full max-w-2xl bg-slate-900 border-slate-800 flex flex-col max-h-[90vh] overflow-hidden p-0 shadow-2xl relative">
        <!-- Close button (Compact & polished in top-right absolute position) -->
        <button onclick="closeProfileModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white hover:bg-slate-800/60 p-2 rounded-xl transition-all z-10 cursor-pointer text-sm">
            <i class="fas fa-times"></i>
        </button>

        <div class="p-6 border-b border-slate-850 pr-12 shrink-0">
            <h3 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-user-circle text-primary-500"></i> Update Profile Settings
            </h3>
            <p class="text-slate-400 text-xs mt-1">Configure your personal information, role details, and social portfolio URLs.</p>
        </div>

        <form action="/dashboard/profile?_method=PUT" method="POST" enctype="multipart/form-data" class="flex-1 overflow-y-auto p-6 space-y-6">
            <!-- Row 1: Name and Email -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Full Name</label>
                    <input type="text" name="name" value="<%= user.name %>" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all font-medium">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Email Address</label>
                    <input type="email" name="email" value="<%= user.email %>" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all font-medium">
                </div>
            </div>

            <!-- Row 2: Location and Profile Picture -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Location / Address</label>
                    <input type="text" name="location" value="<%= user.location || '' %>" placeholder="e.g. New York, USA" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all font-medium">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Upload Profile Avatar</label>
                    <input type="file" name="profilePicture" accept="image/*" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-400 file:mr-4 file:py-1 file:px-3 file:rounded file:border-0 file:text-[10px] file:font-semibold file:bg-primary-600/10 file:text-primary-400 hover:file:bg-primary-600/20 file:cursor-pointer transition-colors">
                </div>
            </div>

            <!-- Row 3: User Type and Seeking Preference -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Professional Role Type</label>
                    <select name="userType" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all font-medium">
                        <option value="" disabled <%= !user.userType ? 'selected' : '' %>>Select Role Type</option>
                        <option value="developer" <%= user.userType === 'developer' ? 'selected' : '' %>>Developer</option>
                        <option value="recruiter" <%= user.userType === 'recruiter' ? 'selected' : '' %>>Recruiter</option>
                        <option value="project_provider" <%= user.userType === 'project_provider' ? 'selected' : '' %>>Project Provider</option>
                        <option value="hobbyist" <%= user.userType === 'hobbyist' ? 'selected' : '' %>>Hobbyist</option>
                        <option value="other" <%= user.userType === 'other' ? 'selected' : '' %>>Other</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Seeking Intent</label>
                    <select name="seeking" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all font-medium">
                        <option value="" disabled <%= !user.seeking ? 'selected' : '' %>>Select Seeking Intent</option>
                        <option value="hiring_talent" <%= user.seeking === 'hiring_talent' ? 'selected' : '' %>>Hiring Talent</option>
                        <option value="freelance_work" <%= user.seeking === 'freelance_work' ? 'selected' : '' %>>Freelance Work</option>
                        <option value="collaboration" <%= user.seeking === 'collaboration' ? 'selected' : '' %>>Collaboration</option>
                        <option value="networking" <%= user.seeking === 'networking' ? 'selected' : '' %>>Networking</option>
                        <option value="exploration" <%= user.seeking === 'exploration' ? 'selected' : '' %>>Exploration</option>
                        <option value="other" <%= user.seeking === 'other' ? 'selected' : '' %>>Other</option>
                    </select>
                </div>
            </div>

            <!-- Row 4: Bio -->
            <div>
                <label class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Brief Biography</label>
                <textarea name="bio" rows="3" maxlength="250" placeholder="Tell the community a little about yourself (max 250 characters)..." class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500/20 transition-all font-medium"><%= user.bio || '' %></textarea>
            </div>

            <!-- Row 5: Social Connections -->
            <div class="pt-4 border-t border-slate-850">
                <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-4 flex items-center gap-1.5">
                    <i class="fas fa-share-alt text-primary-400"></i> Social Profiles & Websites
                </h4>
                
                <%
                    const userSocials = {};
                    (user.socialProfileLinks || []).forEach(s => { userSocials[s.label] = s.link; });
                %>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[10px] font-semibold text-slate-450 uppercase tracking-wider mb-2">GitHub Profile URL</label>
                        <input type="url" name="github" value="<%= userSocials.github || '' %>" placeholder="https://github.com/username" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                    </div>
                    <div>
                        <label class="block text-[10px] font-semibold text-slate-450 uppercase tracking-wider mb-2">LinkedIn Profile URL</label>
                        <input type="url" name="linkedin" value="<%= userSocials.linkedin || '' %>" placeholder="https://linkedin.com/in/username" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                    </div>
                    <div>
                        <label class="block text-[10px] font-semibold text-slate-450 uppercase tracking-wider mb-2">Twitter Profile URL</label>
                        <input type="url" name="twitter" value="<%= userSocials.twitter || '' %>" placeholder="https://twitter.com/username" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                    </div>
                    <div>
                        <label class="block text-[10px] font-semibold text-slate-450 uppercase tracking-wider mb-2">Instagram Profile URL</label>
                        <input type="url" name="instagram" value="<%= userSocials.instagram || '' %>" placeholder="https://instagram.com/username" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                    </div>
                    <div>
                        <label class="block text-[10px] font-semibold text-slate-450 uppercase tracking-wider mb-2">Facebook Profile URL</label>
                        <input type="url" name="facebook" value="<%= userSocials.facebook || '' %>" placeholder="https://facebook.com/username" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                    </div>
                    <div>
                        <label class="block text-[10px] font-semibold text-slate-450 uppercase tracking-wider mb-2">Personal Website Link</label>
                        <input type="url" name="website" value="<%= userSocials.website || '' %>" placeholder="https://yourwebsite.com" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                    </div>
                </div>
            </div>

            <!-- Submit buttons -->
            <div class="pt-6 border-t border-slate-850 flex justify-end gap-3 shrink-0">
                <button type="button" onclick="closeProfileModal()" class="px-5 py-2.5 bg-slate-950 hover:bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl text-xs text-slate-400 hover:text-white transition-all font-semibold cursor-pointer">
                    Cancel
                </button>
                <button type="submit" class="btn-primary px-5 py-2.5 rounded-xl text-xs font-semibold cursor-pointer">
                    Save Profile Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 2: Create / Edit Announcement (Admin Only) -->
<% if (user.role === 'admin') { %>
    <div id="announcementModal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 transition-opacity duration-300">
        <div class="glass-card w-full max-w-lg bg-slate-900 border-slate-800 flex flex-col p-0 shadow-2xl relative">
            <!-- Close button (Compact & polished in top-right absolute position) -->
            <button onclick="closeAnnouncementModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white hover:bg-slate-800/60 p-2 rounded-xl transition-all z-10 cursor-pointer text-sm">
                <i class="fas fa-times"></i>
            </button>

            <div class="p-6 border-b border-slate-850 pr-12">
                <h3 id="announcementModalTitle" class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fas fa-bullhorn text-primary-500"></i> Write Community Update
                </h3>
                <p class="text-slate-400 text-xs mt-1">This notification will display to all logged-in community members.</p>
            </div>

            <form id="announcementForm" action="/dashboard/announcements" method="POST" class="p-6 space-y-5">
                <!-- Message text -->
                <div>
                    <label class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Announcement Body Text</label>
                    <textarea id="announcementText" name="announcement" rows="4" required placeholder="Type the update text message here..." class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium"></textarea>
                </div>

                <!-- Announcement Type -->
                <div>
                    <label class="block text-xs font-semibold text-slate-455 uppercase tracking-wider mb-2">Announcement Type</label>
                    <select id="announcementType" name="type" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium cursor-pointer">
                        <option value="community">Community</option>
                        <option value="Resume">Resume</option>
                        <option value="system update">System Update</option>
                    </select>
                </div>

                <!-- Expire Date -->
                <div>
                    <label class="block text-xs font-semibold text-slate-450 uppercase tracking-wider mb-2">Expiration Date (Optional)</label>
                    <input type="date" id="announcementEndDate" name="endDate" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:border-primary-500 focus:outline-none transition-all font-medium">
                    <span class="text-[10px] text-slate-500 block mt-1.5">If left empty, defaults to 7 days from creation.</span>
                </div>

                <!-- Active status -->
                <div id="activeCheckboxContainer" class="flex items-center gap-3 bg-slate-950/50 p-3 border border-slate-850 rounded-xl">
                    <input type="checkbox" id="announcementIsActive" name="isActive" value="true" checked class="w-4 h-4 text-primary-600 bg-slate-950 border-slate-800 rounded focus:ring-primary-500 focus:ring-2 focus:ring-offset-slate-900 cursor-pointer">
                    <label for="announcementIsActive" class="text-xs font-semibold text-slate-350 select-none cursor-pointer">Is Active & Visible Immediately</label>
                </div>

                <!-- Actions -->
                <div class="pt-4 border-t border-slate-850 flex justify-end gap-3">
                    <button type="button" onclick="closeAnnouncementModal()" class="px-4 py-2 bg-slate-950 hover:bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl text-xs text-slate-400 hover:text-white transition-all font-semibold cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" id="announcementSubmitButton" class="btn-primary px-4 py-2 rounded-xl text-xs font-semibold cursor-pointer">
                        Post Announcement
                    </button>
                </div>
            </form>
        </div>
    </div>
<% } %>


<!-- ===========================================================================
     SCRIPTS & EVENT LISTENERS
     =========================================================================== -->
<script>
    // ─────────────────────────────────────────────────────────────────────────
    // Edit Profile Modal
    // ─────────────────────────────────────────────────────────────────────────
    const profileModal = document.getElementById('profileModal');
    
    function openProfileModal() {
        if (!profileModal) return;
        profileModal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }
    
    function closeProfileModal() {
        if (!profileModal) return;
        profileModal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Announcement CRUD Modal (Admin Only)
    // ─────────────────────────────────────────────────────────────────────────
    const announcementModal = document.getElementById('announcementModal');
    const announcementForm = document.getElementById('announcementForm');
    const announcementModalTitle = document.getElementById('announcementModalTitle');
    const announcementText = document.getElementById('announcementText');
    const announcementEndDate = document.getElementById('announcementEndDate');
    const announcementIsActive = document.getElementById('announcementIsActive');
    const activeCheckboxContainer = document.getElementById('activeCheckboxContainer');
    const announcementSubmitButton = document.getElementById('announcementSubmitButton');

    function openAnnouncementModalForCreate() {
        if (!announcementModal) return;
        
        // Reset form to Create Mode
        announcementForm.action = "/dashboard/announcements";
        announcementModalTitle.innerHTML = '<i class="fas fa-bullhorn text-primary-500"></i> Write Community Update';
        announcementText.value = '';
        announcementEndDate.value = '';
        const announcementTypeField = document.getElementById('announcementType');
        if (announcementTypeField) announcementTypeField.value = 'community';
        if (announcementIsActive) announcementIsActive.checked = true;
        if (activeCheckboxContainer) activeCheckboxContainer.classList.remove('hidden');
        announcementSubmitButton.textContent = 'Post Announcement';
        
        announcementModal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    function openAnnouncementModalForEdit(btn) {
        if (!announcementModal) return;

        const id = btn.getAttribute('data-id');
        const announcement = btn.getAttribute('data-announcement');
        const isActive = btn.getAttribute('data-isactive') === 'true';
        const endDate = btn.getAttribute('data-enddate');
        const type = btn.getAttribute('data-type') || 'community';

        // Configure form for Update Mode
        announcementForm.action = `/dashboard/announcements/${id}?_method=PUT`;
        announcementModalTitle.innerHTML = '<i class="fas fa-edit text-primary-500"></i> Edit Community Announcement';
        announcementText.value = announcement;
        announcementEndDate.value = endDate || '';
        const announcementTypeField = document.getElementById('announcementType');
        if (announcementTypeField) announcementTypeField.value = type;
        if (announcementIsActive) announcementIsActive.checked = isActive;
        if (activeCheckboxContainer) activeCheckboxContainer.classList.add('hidden');
        announcementSubmitButton.textContent = 'Save Changes';

        announcementModal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    function closeAnnouncementModal() {
        if (!announcementModal) return;
        announcementModal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    // Close Modals on Outer Backdrop Click
    window.addEventListener('click', (e) => {
        if (e.target === profileModal) closeProfileModal();
        if (e.target === announcementModal) closeAnnouncementModal();
    });
</script>
