<!-- Projects Section -->
<section id="projects" class="pt-12 pb-12 border-t border-slate-900 bg-slate-950" style="scroll-margin-top: 6rem;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section header -->
        <div class="mb-10">
            <h2 class="font-semibold text-primary-500 uppercase tracking-[0.2em] mb-2" style="font-size: 1.225rem;">Engineering Showcase</h2>
            <h3 class="text-4xl md:text-5xl font-bold text-white leading-tight">Featured Projects</h3>
        </div>

        <%
            const fp = (typeof featuredProjects !== 'undefined' && featuredProjects) ? featuredProjects : [];
            // Show max 5 project cards; 6th slot is always the View All card
            const displayCards = fp.slice(0, 5);
            const showViewAll  = fp.length >= 5; // 6th slot appears when we have 5+ projects
        %>

        <% if (fp.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                <%  displayCards.forEach((project, i) => {
                        const hasLogo = project.logoUrl && project.logoUrl !== '';
                        const hasImg  = project.image && !project.image.endsWith('no-photo.jpg');
                %>
                    <!-- ── PROJECT CARD ── -->
                    <a href="/projects/<%= project._id %>"
                       class="fp-card group relative flex flex-col overflow-hidden rounded-2xl border border-slate-800/60 bg-gradient-to-b from-slate-900/80 to-slate-950/90 backdrop-blur-sm h-[400px]"
                       style="animation: fade-in 0.55s <%= (i * 0.08).toFixed(2) %>s ease-out both; height: 400px;">

                        <!-- ── VISUAL AREA (logo > gallery > placeholder) ── -->
                        <div class="relative overflow-hidden shrink-0" style="height: calc(100% - 96px);">

                            <% if (hasLogo) { %>
                                <!-- Logo mode -->
                                <div class="absolute inset-0" style="background: linear-gradient(145deg,#08172e 0%,#0d2540 40%,#061322 100%);"></div>
                                <div class="absolute inset-0 opacity-[0.12]" style="background-image: radial-gradient(circle,rgba(14,165,233,0.8) 1px,transparent 1px); background-size:22px 22px;"></div>
                                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                    <div class="w-52 h-52 rounded-full opacity-25 blur-3xl" style="background:radial-gradient(circle,rgba(14,165,233,1) 0%,transparent 70%);"></div>
                                </div>
                                <img src="<%= project.logoUrl %>" alt="<%= project.title %> logo"
                                     class="absolute inset-0 fp-logo"
                                     style="width:100%;height:100%;object-fit:contain;padding:28px;box-sizing:border-box;filter:drop-shadow(0 6px 24px rgba(14,165,233,0.3)) drop-shadow(0 2px 10px rgba(0,0,0,0.5));transition:transform 0.5s cubic-bezier(0.34,1.56,0.64,1),filter 0.4s ease;">
                                <div class="absolute bottom-0 left-0 right-0 h-10" style="background:linear-gradient(to top,rgba(6,13,22,0.7),transparent);"></div>

                            <% } else if (hasImg) { %>
                                <!-- Gallery image mode -->
                                <img src="<%= project.image %>" alt="<%= project.title %>"
                                     class="absolute inset-0 w-full h-full object-cover"
                                     style="transition:transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94);">
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/10 to-transparent"></div>

                            <% } else { %>
                                <!-- Placeholder mode -->
                                <div class="absolute inset-0" style="background:linear-gradient(145deg,#08172e 0%,#0d2540 40%,#061322 100%);"></div>
                                <div class="absolute inset-0 opacity-[0.08]" style="background-image:radial-gradient(circle,rgba(14,165,233,0.8) 1px,transparent 1px);background-size:22px 22px;"></div>
                                <div class="absolute inset-0 flex flex-col items-center justify-center gap-3">
                                    <div class="w-14 h-14 rounded-2xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center">
                                        <i class="fas fa-layer-group text-2xl text-slate-600"></i>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <!-- ── CURTAIN DRAWER (slides up on hover) ── -->
                        <!--
                            Before hover: shows title + badges (always-visible header portion)
                            On hover: full curtain slides up revealing description + tech chips
                        -->
                        <div class="fp-drawer absolute inset-x-0 bottom-0 z-20 bg-slate-950/95 backdrop-blur-md border-t border-slate-800/60"
                             style="transform: translateY(calc(100% - 96px)); transition: transform 0.45s cubic-bezier(0.4,0,0.2,1);">

                            <!-- Always-visible portion: title + badges -->
                            <div class="px-5 pt-4 pb-3" style="min-height: 96px;">
                                <h4 class="text-[15px] font-extrabold text-white leading-snug mb-2.5 line-clamp-2"
                                    style="transition: color 0.2s ease;">
                                    <%= project.title %>
                                </h4>
                                <!-- Category + Type + Featured badges -->
                                <div class="flex flex-wrap items-center gap-1.5">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-primary-950/80 border border-primary-800/50 text-primary-400 rounded-md text-[9px] font-bold uppercase tracking-wider">
                                        <%= project.category %>
                                    </span>
                                    <% if (project.projectType === 'professional') { %>
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-emerald-950/80 border border-emerald-800/50 text-emerald-400 rounded-md text-[9px] font-bold uppercase tracking-wider">
                                            <i class="fas fa-briefcase text-[7px]"></i> Work
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-blue-950/80 border border-blue-800/50 text-blue-400 rounded-md text-[9px] font-bold uppercase tracking-wider">
                                            <i class="fas fa-code text-[7px]"></i> Personal
                                        </span>
                                    <% } %>
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-yellow-950/80 border border-yellow-800/50 text-yellow-400 rounded-md text-[9px] font-bold uppercase tracking-wider">
                                        <i class="fas fa-star text-[7px]"></i> Featured
                                    </span>
                                </div>
                            </div>

                            <!-- Hidden details: revealed when curtain rises -->
                            <div class="px-5 pb-6 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-150">
                                <p class="text-slate-400 text-[12.5px] leading-relaxed line-clamp-3 mb-3">
                                    <%= project.description %>
                                </p>
                                <!-- Tech chips -->
                                <div class="border-t border-slate-800/50 pt-3 flex flex-wrap gap-1">
                                    <% if (project.technologies && project.technologies.length > 0) { %>
                                        <% project.technologies.slice(0, 6).forEach(tech => { %>
                                            <span class="px-1.5 py-0.5 bg-slate-800/60 border border-slate-700/40 rounded text-[9px] font-semibold text-slate-400 uppercase tracking-wide whitespace-nowrap">
                                                <%= tech %>
                                            </span>
                                        <% }); %>
                                        <% if (project.technologies.length > 6) { %>
                                            <span class="px-1.5 py-0.5 bg-primary-950/60 border border-primary-900/50 rounded text-[9px] font-bold text-primary-500 whitespace-nowrap">
                                                +<%= project.technologies.length - 6 %>
                                            </span>
                                        <% } %>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                    </a><!-- /fp-card -->
                <% }); %>

                <!-- ── 6TH SLOT: View All card ── -->
                <% if (showViewAll || fp.length > 0) { %>
                    <a href="/projects"
                       class="fp-viewall-card group flex flex-col items-center justify-center rounded-2xl border border-slate-800/60 border-dashed bg-slate-900/30 hover:bg-slate-900/60 hover:border-primary-500/40 transition-all duration-300 h-[400px]"
                       style="animation: fade-in 0.55s <%= (Math.min(fp.length, 5) * 0.08).toFixed(2) %>s ease-out both; height: 400px;">
                        <div class="flex flex-col items-center gap-4 text-center px-6">
                            <div class="w-14 h-14 rounded-2xl bg-slate-800/80 group-hover:bg-primary-600/20 border border-slate-700/60 group-hover:border-primary-500/40 flex items-center justify-center transition-all duration-300">
                                <i class="fas fa-layer-group text-2xl text-slate-500 group-hover:text-primary-400 transition-colors duration-300"></i>
                            </div>
                            <div>
                                <div class="text-white font-extrabold text-base mb-1 group-hover:text-primary-400 transition-colors duration-200">View All Projects</div>
                                <div class="text-slate-500 text-xs leading-relaxed">Explore the complete portfolio of backend projects and engineering work</div>
                            </div>
                            <div class="inline-flex items-center gap-2 px-4 py-2 bg-slate-800/80 group-hover:bg-primary-600 border border-slate-700/60 group-hover:border-primary-500 text-slate-400 group-hover:text-white rounded-xl text-xs font-bold transition-all duration-200">
                                <i class="fas fa-arrow-right text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                                Browse All
                            </div>
                        </div>
                    </a>
                <% } %>

            </div>

        <% } else { %>
            <!-- Empty state: no featured projects yet -->
            <div class="flex flex-col items-center justify-center py-20 rounded-2xl border border-dashed border-slate-800/60 text-center">
                <div class="w-16 h-16 rounded-2xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center mb-5">
                    <i class="fas fa-layer-group text-2xl text-slate-600"></i>
                </div>
                <h4 class="text-lg font-bold text-white mb-2">No Featured Projects Yet</h4>
                <p class="text-slate-500 text-sm max-w-sm">Featured projects will appear here once they are added and marked as featured.</p>
            </div>
        <% } %>

    </div>
</section>

<style>
/* ── Featured project card: curtain hover ── */
.fp-card:hover .fp-drawer {
    transform: translateY(0) !important;
}
.fp-card:hover .fp-logo {
    filter: drop-shadow(0 8px 36px rgba(14,165,233,0.5)) drop-shadow(0 2px 10px rgba(0,0,0,0.6)) !important;
    transform: scale(1.04);
}
.fp-card:hover img:not(.fp-logo) {
    transform: scale(1.05);
}
.fp-card:hover h4 { color: #38bdf8; }
.fp-card {
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
.fp-card:hover {
    border-color: rgba(14,165,233,0.35);
    box-shadow: 0 0 0 1px rgba(14,165,233,0.1), 0 20px 48px -12px rgba(0,0,0,0.7), 0 0 40px -20px rgba(14,165,233,0.15);
}
</style>

<!-- Appointment / Contact Section -->
<section id="contact" class="pt-16 pb-20 bg-slate-900/30" style="scroll-margin-top: 6rem;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
                <h2 class="font-semibold text-primary-500 uppercase tracking-[0.2em] mb-4" style="font-size: 1.225rem;">Get In Touch</h2>
                <h3 class="text-4xl md:text-5xl font-bold text-white mb-8">Ready to Scale Your Next Big Project?</h3>
                <p class="text-slate-400 text-lg mb-10 leading-relaxed">
                    Whether you need a full system architect or a specialized backend developer, I'm here to help you
                    build something amazing. Book a consultation or send a request.
                </p>

                <div class="space-y-6">
                    <div class="flex items-start gap-4">
                        <div
                            class="w-12 h-12 bg-slate-800 rounded-lg flex items-center justify-center text-primary-500 shrink-0">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div>
                            <div class="text-white font-medium">Email Me</div>
                            <div class="text-slate-400">ajayrajput3355@gmail.com</div>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-12 h-12 bg-slate-800 rounded-lg flex items-center justify-center text-primary-500 shrink-0">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div>
                            <div class="text-white font-medium">Phone</div>
                            <% if (user) { %>
                                <div class="text-slate-400">+91 8219799768</div>
                                <% } else { %>
                                    <div class="text-slate-500 italic text-sm"><i class="fas fa-lock text-xs mr-1"></i>
                                        Login to view phone number</div>
                                    <% } %>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-12 h-12 bg-slate-800 rounded-lg flex items-center justify-center text-primary-500 shrink-0">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div>
                            <div class="text-white font-medium">Location</div>
                            <div class="text-slate-400">India / Remote Available</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="glass-card p-8 md:p-10 border-slate-700/50">
                <%- include('partials/flash') %>

                <!-- Connect Form (Public) -->
                <div class="space-y-6">
                    <p class="text-slate-400 text-sm mb-6 font-medium">Send a quick message or inquiry. No registration required.</p>
                    <form action="/connect" method="POST" class="space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-slate-400 mb-2">Name</label>
                                <input type="text" name="name" required
                                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors"
                                    placeholder="John Doe">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-400 mb-2">Email</label>
                                <input type="email" name="email" required
                                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors"
                                    placeholder="email@example.com">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-400 mb-2">Message</label>
                            <textarea name="message" rows="4" required
                                class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors"
                                placeholder="Hi Ajay, let's chat about..."></textarea>
                        </div>
                        <input type="hidden" name="subject" value="General Inquiry">
                        <button type="submit" class="w-full btn-primary py-4 text-lg font-bold">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
