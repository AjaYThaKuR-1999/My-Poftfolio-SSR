<!-- Projects Section -->
<section id="projects" class="pt-16 pb-16 border-t border-slate-900 bg-slate-950" style="scroll-margin-top: 6rem;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
            <div class="max-w-2xl">
                <h2 class="font-semibold text-primary-500 uppercase tracking-[0.2em] mb-4" style="font-size: 1.225rem;">Engineering Showcase</h2>
                <h3 class="text-4xl md:text-5xl font-bold text-white leading-tight">Featured Projects</h3>
            </div>
            <a href="/projects"
                class="text-primary-500 hover:text-primary-400 font-semibold flex items-center gap-2 group transition-colors">
                View All Projects <i
                    class="fas fa-arrow-right text-sm group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% if (typeof projects !=='undefined' && projects && projects.length> 0) { %>
                <% projects.forEach(project=> { %>
                    <div class="relative h-[380px] rounded-xl overflow-hidden border border-slate-800 bg-slate-950 group hover:border-primary-500/50 transition-all duration-500">
                        <!-- Image Container (Background) -->
                        <div class="absolute inset-0 w-full h-full bg-slate-900">
                            <% if (project.image && project.image !== 'no-photo.jpg') { %>
                                <img src="<%= project.image %>" alt="<%= project.title %>" class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center text-slate-850 bg-slate-950">
                                    <i class="fas fa-code text-5xl"></i>
                                </div>
                            <% } %>
                            <!-- Dark Overlay gradient -->
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
                        </div>

                        <!-- Content Drawer (slides up on hover) -->
                        <div class="absolute inset-x-0 bottom-0 z-20 p-6 bg-slate-950/90 backdrop-blur-md border-t border-slate-900/50 translate-y-[calc(100%-5.5rem)] group-hover:translate-y-0 transition-all duration-500 ease-out flex flex-col h-[280px]">
                            <!-- Always visible top header -->
                            <div class="flex items-center justify-between mb-4 h-14 shrink-0">
                                <h4 class="text-lg font-bold text-white group-hover:text-primary-400 transition-colors line-clamp-1 pr-2"><%= project.title %></h4>
                                <span class="px-2 py-0.5 rounded bg-primary-600/90 text-white font-bold text-[8px] uppercase tracking-wider shrink-0">
                                    <%= project.category %>
                                </span>
                            </div>

                            <!-- Hidden details revealed on hover -->
                            <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100 flex flex-col justify-between flex-grow overflow-hidden">
                                <p class="text-slate-350 text-xs leading-relaxed line-clamp-3 mb-4">
                                    <%= project.description %>
                                </p>
                                
                                <div>
                                    <!-- Technologies -->
                                    <div class="flex flex-wrap gap-1 mb-4">
                                        <% if (project.technologies && project.technologies.length > 0) { %>
                                            <% project.technologies.slice(0, 4).forEach(tech => { %>
                                                <span class="px-2 py-0.5 bg-slate-900 border border-slate-800 rounded text-[9px] font-medium text-slate-400 uppercase">
                                                    <%= tech %>
                                                </span>
                                            <% }); %>
                                            <% if (project.technologies.length > 4) { %>
                                                <span class="px-2 py-0.5 bg-slate-900 border border-slate-800 rounded text-[9px] font-medium text-slate-500">
                                                    +<%= project.technologies.length - 4 %>
                                                </span>
                                            <% } %>
                                        <% } %>
                                    </div>

                                    <!-- Action Links -->
                                    <div class="flex items-center gap-4 pt-3 border-t border-slate-900">
                                        <% if (project.githubUrl) { %>
                                            <a href="<%= project.githubUrl %>" target="_blank" class="text-xs font-semibold text-slate-300 hover:text-white flex items-center gap-1.5 transition-colors">
                                                <i class="fab fa-github"></i> Code
                                            </a>
                                        <% } %>
                                        <% if (project.liveUrl) { %>
                                            <a href="<%= project.liveUrl %>" target="_blank" class="text-xs font-semibold text-primary-500 hover:text-primary-400 flex items-center gap-1.5 transition-colors ml-auto">
                                                <i class="fas fa-external-link-alt"></i> Live Demo
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                        <% } else { %>
                            <div class="col-span-full text-center py-12 text-slate-500">
                                No projects found. Check back later!
                            </div>
                            <% } %>
        </div>
    </div>
</section>

<!-- Appointment / Contact Section -->
<section id="contact" class="pt-16 pb-16 bg-slate-900/30" style="scroll-margin-top: 6rem;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
                <h2 class="font-semibold text-primary-500 uppercase tracking-[0.2em] mb-4" style="font-size: 1.225rem;">Get In Touch</h2>
                <h3 class="text-4xl md:text-5xl font-bold text-white mb-8">Ready to Scale Your Next Big Project?</h3>
                <p class="text-slate-400 text-lg mb-10 leading-relaxed">
                    Whether you need a full system architect or a specialized backend developer, I'm here to help you
                    build something amazing. Book a consultation or send a request.
                </p>

                <div class="space-y-6">
                    <div class="flex items-start gap-4">
                        <div
                            class="w-12 h-12 bg-slate-800 rounded-lg flex items-center justify-center text-primary-500 shrink-0">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div>
                            <div class="text-white font-medium">Email Me</div>
                            <div class="text-slate-400">ajayrajput3355@gmail.com</div>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-12 h-12 bg-slate-800 rounded-lg flex items-center justify-center text-primary-500 shrink-0">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div>
                            <div class="text-white font-medium">Phone</div>
                            <% if (user) { %>
                                <div class="text-slate-400">+91 8219799768</div>
                                <% } else { %>
                                    <div class="text-slate-500 italic text-sm"><i class="fas fa-lock text-xs mr-1"></i>
                                        Login to view phone number</div>
                                    <% } %>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-12 h-12 bg-slate-800 rounded-lg flex items-center justify-center text-primary-500 shrink-0">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div>
                            <div class="text-white font-medium">Location</div>
                            <div class="text-slate-400">India / Remote Available</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="glass-card p-8 md:p-10 border-slate-700/50">
                <!-- Tabs Navigation -->
                <div class="flex border-b border-slate-800 mb-8 gap-6">
                    <button id="tab-connect"
                        class="pb-4 text-lg font-bold text-white border-b-2 border-primary-500 focus:outline-none transition-all cursor-pointer">
                        Let's Connect
                    </button>
                    <button id="tab-help"
                        class="pb-4 text-lg font-bold text-slate-400 border-b-2 border-transparent hover:text-slate-200 focus:outline-none transition-all cursor-pointer">
                        Project Help
                    </button>
                </div>

                <%- include('partials/flash') %>

                    <!-- Tab 1: Connect Form (Public) -->
                    <div id="form-connect" class="space-y-6">
                        <p class="text-slate-400 text-sm mb-6">Send a quick message or inquiry. No registration
                            required.</p>
                        <form action="/connect" method="POST" class="space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-slate-400 mb-2">Name</label>
                                    <input type="text" name="name" required
                                        class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors"
                                        placeholder="John Doe">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-400 mb-2">Email</label>
                                    <input type="email" name="email" required
                                        class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors"
                                        placeholder="email@example.com">
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-400 mb-2">Message</label>
                                <textarea name="message" rows="4" required
                                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors"
                                    placeholder="Hi Ajay, let's chat about..."></textarea>
                            </div>
                            <input type="hidden" name="subject" value="General Inquiry">
                            <button type="submit" class="w-full btn-primary py-4 text-lg font-bold">Send
                                Message</button>
                        </form>
                    </div>

                    <!-- Tab 2: Project Help Request (Protected) -->
                    <div id="form-help" class="hidden space-y-6">
                        <% if (user) { %>
                            <p class="text-slate-400 text-sm mb-6">Submit a project help request or schedule a booking.
                                Track progress in your dashboard.</p>
                            <form action="/contact" method="POST" class="space-y-6">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-400 mb-2">Name</label>
                                        <input type="text" name="name" value="<%= user.name %>" readonly
                                            class="w-full bg-slate-950/50 border border-slate-800 rounded-lg px-4 py-3 text-slate-300 focus:outline-none cursor-not-allowed">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-400 mb-2">Email</label>
                                        <input type="email" name="email" value="<%= user.email %>" readonly
                                            class="w-full bg-slate-950/50 border border-slate-800 rounded-lg px-4 py-3 text-slate-300 focus:outline-none cursor-not-allowed">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-400 mb-2">Subject</label>
                                    <select name="subject"
                                        class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors">
                                        <option value="help">Project Help Request</option>
                                        <option value="appointment">Book an Appointment</option>
                                        <option value="other">General Inquiry</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-400 mb-2">Message</label>
                                    <textarea name="message" rows="4" required
                                        class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:border-primary-500 focus:outline-none transition-colors"
                                        placeholder="Tell me about your project..."></textarea>
                                </div>
                                <button type="submit" class="w-full btn-primary py-4 text-lg font-bold">Send
                                    Request</button>
                            </form>
                            <% } else { %>
                                <div class="text-center py-10 flex flex-col items-center justify-center">
                                    <div
                                        class="w-20 h-20 bg-slate-800/80 border border-slate-700/50 rounded-full flex items-center justify-center text-primary-500 text-3xl mb-6 shadow-lg shadow-primary-500/5 animate-pulse">
                                        <i class="fas fa-lock"></i>
                                    </div>
                                    <h4 class="text-2xl font-bold text-white mb-4">Request Area Locked</h4>
                                    <p class="text-slate-400 text-sm max-w-sm mx-auto mb-8 leading-relaxed">
                                        To maintain quality and prevent spam, only registered community members can
                                        submit project help requests and schedule bookings.
                                    </p>
                                    <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
                                        <a href="/auth/login" class="btn-primary py-3 px-8 text-center font-bold">
                                            Sign In
                                        </a>
                                        <a href="/auth/register"
                                            class="px-8 py-3 bg-slate-950 border border-slate-800 hover:border-slate-700 hover:text-white text-slate-300 rounded-lg text-center transition-all font-bold">
                                            Create Account
                                        </a>
                                    </div>
                                </div>
                                <% } %>
                    </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tabConnect = document.getElementById('tab-connect');
        const tabHelp = document.getElementById('tab-help');
        const formConnect = document.getElementById('form-connect');
        const formHelp = document.getElementById('form-help');

        if (tabConnect && tabHelp) {
            tabConnect.addEventListener('click', () => {
                tabConnect.classList.add('text-white', 'border-primary-500');
                tabConnect.classList.remove('text-slate-400', 'border-transparent');
                tabHelp.classList.remove('text-white', 'border-primary-500');
                tabHelp.classList.add('text-slate-400', 'border-transparent');
                formConnect.classList.remove('hidden');
                formHelp.classList.add('hidden');
            });

            tabHelp.addEventListener('click', () => {
                tabHelp.classList.add('text-white', 'border-primary-500');
                tabHelp.classList.remove('text-slate-400', 'border-transparent');
                tabConnect.classList.remove('text-white', 'border-primary-500');
                tabConnect.classList.add('text-slate-400', 'border-transparent');
                formHelp.classList.remove('hidden');
                formConnect.classList.add('hidden');
            });
        }
    });
</script>




