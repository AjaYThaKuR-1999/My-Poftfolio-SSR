<!-- Projects Section -->
<section id="projects" class="pt-12 pb-12 border-t border-slate-900 bg-slate-950" style="scroll-margin-top: 6rem;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section header -->
        <div class="mb-10">
            <h2 class="font-semibold text-primary-500 uppercase tracking-[0.2em] mb-2" style="font-size: 1.225rem;">Engineering Showcase</h2>
            <h3 class="text-4xl md:text-5xl font-bold text-white leading-tight">Featured Projects</h3>
        </div>

        <%
            const fp = (typeof featuredProjects !== 'undefined' && featuredProjects) ? featuredProjects : [];
            // Show max 5 project cards; 6th slot is always the View All card
            const displayCards = fp.slice(0, 5);
            const showViewAll  = fp.length >= 5; // 6th slot appears when we have 5+ projects
        %>

        <% if (fp.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                <%  displayCards.forEach((project, i) => {
                        const hasLogo = project.logoUrl && project.logoUrl !== '';
                        const hasImg  = project.image && !project.image.endsWith('no-photo.jpg');
                %>
                    <!-- ── PROJECT CARD ── -->
                    <a href="/projects/<%= project._id %>"
                       class="fp-card group relative flex flex-col overflow-hidden rounded-2xl border border-slate-800/60 bg-gradient-to-b from-slate-900/80 to-slate-950/90 backdrop-blur-sm h-[400px]"
                       style="--delay: <%= (i * 0.08).toFixed(2) %>s; height: 400px;">

                        <!-- ── VISUAL AREA (logo > gallery > placeholder) ── -->
                        <div class="relative overflow-hidden shrink-0" style="height: calc(100% - 96px);">

                            <% if (hasLogo) { %>
                                <!-- Logo mode -->
                                <div class="absolute inset-0" style="background: linear-gradient(145deg,#08172e 0%,#0d2540 40%,#061322 100%);"></div>
                                <div class="absolute inset-0 opacity-[0.12]" style="background-image: radial-gradient(circle,rgba(14,165,233,0.8) 1px,transparent 1px); background-size:22px 22px;"></div>
                                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                    <div class="w-52 h-52 rounded-full opacity-25 blur-3xl" style="background:radial-gradient(circle,rgba(14,165,233,1) 0%,transparent 70%);"></div>
                                </div>
                                <img src="<%= project.logoUrl %>" alt="<%= project.title %> logo"
                                     class="absolute inset-0 fp-logo"
                                     style="width:100%;height:100%;object-fit:contain;padding:28px;box-sizing:border-box;filter:drop-shadow(0 6px 24px rgba(14,165,233,0.3)) drop-shadow(0 2px 10px rgba(0,0,0,0.5));transition:transform 0.5s cubic-bezier(0.34,1.56,0.64,1),filter 0.4s ease;">
                                <div class="absolute bottom-0 left-0 right-0 h-10" style="background:linear-gradient(to top,rgba(6,13,22,0.7),transparent);"></div>

                            <% } else if (hasImg) { %>
                                <!-- Gallery image mode -->
                                <img src="<%= project.image %>" alt="<%= project.title %>"
                                     class="absolute inset-0 w-full h-full object-cover"
                                     style="transition:transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94);">
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/10 to-transparent"></div>

                            <% } else { %>
                                <!-- Placeholder mode -->
                                <div class="absolute inset-0" style="background:linear-gradient(145deg,#08172e 0%,#0d2540 40%,#061322 100%);"></div>
                                <div class="absolute inset-0 opacity-[0.08]" style="background-image:radial-gradient(circle,rgba(14,165,233,0.8) 1px,transparent 1px);background-size:22px 22px;"></div>
                                <div class="absolute inset-0 flex flex-col items-center justify-center gap-3">
                                    <div class="w-14 h-14 rounded-2xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center">
                                        <i class="fas fa-layer-group text-2xl text-slate-600"></i>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <!-- ── CURTAIN DRAWER (slides up on hover) ── -->
                        <!--
                            Before hover: shows title + badges (always-visible header portion)
                            On hover: full curtain slides up revealing description + tech chips
                        -->
                        <div class="fp-drawer absolute inset-x-0 bottom-0 z-20 bg-slate-950/95 backdrop-blur-md border-t border-slate-800/60"
                             style="transform: translateY(calc(100% - 96px)); transition: transform 0.45s cubic-bezier(0.4,0,0.2,1);">

                            <!-- Always-visible portion: title + badges -->
