                    <span class="px-3 py-1 bg-slate-800 rounded-md text-xs font-medium text-slate-300">JavaScript</span>
                    <span class="px-3 py-1 bg-slate-800 rounded-md text-xs font-medium text-slate-300">TypeScript</span>
                    <span class="px-3 py-1 bg-slate-800 rounded-md text-xs font-medium text-slate-300">Node.js</span>
