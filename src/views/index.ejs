<!-- Skills Section -->
<section id="skills" class="pt-16 pb-16 relative" style="scroll-margin-top: 6rem;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
            <div class="max-w-2xl">
