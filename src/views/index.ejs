                       style="--delay: <%= (Math.min(fp.length, 5) * 0.08).toFixed(2) %>s; height: 400px;">
                        <div class="flex flex-col items-center gap-4 text-center px-6">
                            <div class="w-14 h-14 rounded-2xl bg-slate-800/80 group-hover:bg-primary-600/20 border border-slate-700/60 group-hover:border-primary-500/40 flex items-center justify-center transition-all duration-300">
                                <i class="fas fa-layer-group text-2xl text-slate-500 group-hover:text-primary-400 transition-colors duration-300"></i>
                            </div>
                            <div>
                                <div class="text-white font-extrabold text-base mb-1 group-hover:text-primary-400 transition-colors duration-200">View All Projects</div>
                                <div class="text-slate-500 text-xs leading-relaxed">Explore the complete portfolio of backend projects and engineering work</div>
                            </div>
                            <div class="inline-flex items-center gap-2 px-4 py-2 bg-slate-800/80 group-hover:bg-primary-600 border border-slate-700/60 group-hover:border-primary-500 text-slate-400 group-hover:text-white rounded-xl text-xs font-bold transition-all duration-200">
